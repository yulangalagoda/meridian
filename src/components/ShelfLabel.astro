---
// A shelf's heading row on Collection and Timeline: the gold pill, a hairline
// and an italic note such as "44 objects · 1826–1979".
interface Props {
  name: string;
  note: string;
}

const { name, note } = Astro.props;
---

<div class="sl">
  <span class="sl-pill">{name}</span>
  <span class="sl-rule"></span>
  <span class="sl-note">{note}</span>
</div>

<style>
  .sl{display:flex;align-items:center;gap:1rem}
  .sl-pill{padding:.4375rem .875rem;background:linear-gradient(135deg,#A8834D,#E6CC92 45%,#A07B45);color:#141008;font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap}
  .sl-rule{flex:1;height:1px;background:rgba(211,179,112,.22)}
  .sl-note{font:italic 400 1rem/1 'EB Garamond',Georgia,serif;color:#8D897F;white-space:nowrap}
</style>
