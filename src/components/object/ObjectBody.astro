---
// The object's story, from its Notion page: each H2 is a numbered section
// (01 Opening, 02 The Object…), the first paragraph opens on a gold drop cap,
// a quote block stands between sections as a pull quote, and the References
// H2 with its list becomes the collapsed source list.
import { blockSpans, plainText, renderSpans } from '../../lib/richtext';

interface Props { blocks: any[] }
const { blocks } = Astro.props;

type Part =
  | { kind: 'section'; num: string; title: string; paras: string[]; afterQuote: boolean }
  | { kind: 'quote'; html: string }
  | { kind: 'refs'; title: string; items: string[] };
const parts: Part[] = [];
let n = 0;
let cur: Part | null = null;
for (const b of blocks) {
  const spans = blockSpans(b);
  if (b.type === 'heading_2' || b.type === 'heading_1') {
    const title = plainText(spans).trim();
    const prev = parts[parts.length - 1];
    cur = /^references$/i.test(title)
      ? { kind: 'refs', title, items: [] }
      : { kind: 'section', num: String(++n).padStart(2, '0'), title, paras: [], afterQuote: prev?.kind === 'quote' };
    parts.push(cur);
  } else if (b.type === 'quote') {
    parts.push({ kind: 'quote', html: renderSpans(spans) });
    cur = null;
  } else if (cur?.kind === 'refs' && (b.type === 'numbered_list_item' || b.type === 'bulleted_list_item')) {
    cur.items.push(renderSpans(spans));
  } else if (b.type === 'paragraph' && spans.length) {
    if (cur?.kind !== 'section') {
      cur = { kind: 'section', num: '', title: '', paras: [], afterQuote: parts[parts.length - 1]?.kind === 'quote' };
      parts.push(cur);
    }
    cur.paras.push(renderSpans(spans));
  }
}

// The drop cap: the first letter of the first section's first paragraph.
const first = blocks.find((b) => b.type === 'paragraph' && blockSpans(b).length);
let drop = '';
let firstRest = '';
if (first) {
  const spans = blockSpans(first);
  drop = (spans[0].plain_text ?? '').charAt(0);
  firstRest = renderSpans([{ ...spans[0], plain_text: spans[0].plain_text.slice(1) }, ...spans.slice(1)]);
}
let dropUsed = false;
const para = (html: string) => {
  if (!dropUsed && first && html === renderSpans(blockSpans(first))) { dropUsed = true; return null; }
  return html;
};
---

<article class="ob-story">
  {parts.map((p, i) =>
    p.kind === 'section' ? (
      <div data-reveal="1" style={i === 0 || p.afterQuote ? undefined : 'margin-top:56px'}>
        {p.num && <div class="ob-num">{p.num}</div>}
        {p.title && <h2 class="ob-h">{p.title}</h2>}
        {p.paras.map((h) => {
          const html = para(h);
          return html === null ? (
            <p class="ob-p"><span class="ob-drop">{drop}</span><Fragment set:html={firstRest} /></p>
          ) : (
            <p class="ob-p" set:html={html} />
          );
        })}
      </div>
    ) : p.kind === 'quote' ? (
      <div data-reveal="1" class="ob-pull"><p set:html={p.html} /></div>
    ) : (
      <details data-reveal="1" class="ob-refs">
        <summary>{p.title} · {p.items.length} sources ↓</summary>
        <ol>{p.items.map((h) => <li set:html={h} />)}</ol>
      </details>
    )
  )}
</article>

<style>
  .ob-story{font:400 1.28125rem/1.72 'EB Garamond',Georgia,serif;color:#D9D2C3;text-wrap:pretty}
  .ob-num{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#8D897F}
  .ob-h{margin:.75rem 0 1.375rem;font:400 2rem/1.15 Gloock,Georgia,serif;color:#F3ECDC}
  .ob-p{margin:0 0 1.1em}
  .ob-p :global(a){color:#F2D493;border-bottom:1px solid rgba(211,179,112,.4)}
  .ob-p :global(strong){font-weight:600;color:#F3ECDC}
  .ob-drop{float:left;font:400 5.375rem/.8 Gloock,Georgia,serif;color:#D3B370;margin:.625rem .875rem 0 0}
  .ob-pull{margin:4rem 0;padding:2.125rem 0;border-top:1px solid rgba(211,179,112,.35);border-bottom:1px solid rgba(211,179,112,.35);text-align:center}
  .ob-pull p{margin:0;font:400 clamp(1.625rem,2.6vw,2.125rem)/1.3 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .ob-refs{margin-top:3.5rem;border-top:1px solid rgba(238,231,215,.12);padding-top:1.125rem}
  .ob-refs summary{cursor:pointer;list-style:none;font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#B8B2A5}
  .ob-refs summary::-webkit-details-marker{display:none}
  .ob-refs ol{margin:1.25rem 0 0;padding-left:1.375rem;font:400 1rem/1.7 'EB Garamond',Georgia,serif;color:#B8B2A5}
</style>
