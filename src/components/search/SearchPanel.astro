---
// The search panel from the Search reference: one large input over the static
// index (/search-index.json), results in four groups with the matches lit in
// gold, ↑ ↓ / ↵ / Esc, "Show N more", a "Try" row when empty and a line to
// Seeking when nothing matches. ⌘K / Ctrl-K selects the box.
//   seed="query"  the box starts from ?q= (the /search page)
//   seed="path"   the box starts from the words of the missing URL (the 404)
import { getSiteData } from '../../lib/notion';

interface Props { seed?: 'query' | 'path' }
const { seed = 'query' } = Astro.props;

const { items, narratives } = await getSiteData();
const placeholder = 'Search ' + items.length + ' objects and ' + narratives.length + ' narratives';
const status = items.length + narratives.length + ' entries, plus the archive pages';
const tries = ['Ceylon', '1927', 'Heinemann', 'camera', 'inscribed', 'Lingard'];
---

<main class="sr" data-search data-seed={seed}>
  <label for="q" class="sr-label">Search the archive</label>
  <div class="sr-box">
    <input id="q" type="search" enterkeyhint="search" autocapitalize="off" data-q placeholder={placeholder} autocomplete="off" spellcheck="false" />
    <button type="button" class="sr-clear" data-clear hidden aria-label="Clear"><span class="sr-clear-w">Clear</span><span class="sr-clear-x" aria-hidden="true">×</span></button>
  </div>
  <div class="sr-status">
    <span data-status>{status}</span>
    <span>↑ ↓ to move · ↵ to open · Esc to clear</span>
  </div>

  <div class="sr-tries" data-tries>
    <span class="sr-try-label">Try</span>
    {tries.map((t) => <button type="button" class="sr-try" data-try={t}>{t}</button>)}
  </div>

  <div data-groups></div>

  <div class="sr-none" data-none hidden>
    <p class="sr-none-q">Nothing in the archive matches “<span data-none-q></span>”.</p>
    <p class="sr-none-p">If it belongs in this story, the <a href="/seeking">Seeking</a> page says how to get in touch.</p>
  </div>
</main>
<style>
  .sr{max-width:56.25rem;margin:0 auto;box-sizing:border-box;padding:clamp(3.5rem,8vw,6.875rem) var(--gut) var(--sec)}
  .sr-label{display:block;font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
  .sr-box{display:flex;align-items:center;gap:1rem;margin-top:1.125rem;border-bottom:1px solid rgba(211,179,112,.6)}
  .sr-box input{flex:1;min-width:0;padding:.625rem 0 1.125rem;background:none;border:0;outline:none;font:400 clamp(1.875rem,4vw,3rem)/1.1 Gloock,Georgia,serif;color:#F3ECDC}
  .sr-box input::placeholder{color:#5E6070}
  .sr-box input{-webkit-appearance:none;appearance:none;border-radius:0}
  .sr-box input::-webkit-search-cancel-button,.sr-box input::-webkit-search-decoration{-webkit-appearance:none;display:none}
  .sr-clear-x{display:none}
  .sr-clear{font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#8D897F}
  @media (hover:hover) and (pointer:fine){.sr-clear:hover{color:#F3ECDC}}
  .sr-clear[hidden]{display:none}
  .sr-status{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.625rem 1.5rem;margin-top:.875rem;font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}

  .sr-tries{display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem 1.375rem;margin-top:3rem}
  .sr-tries[hidden]{display:none}
  .sr-try-label{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}
  .sr-try{font:italic 400 1.1875rem/1.5 'EB Garamond',Georgia,serif;color:#EEE7D7;border-bottom:1px solid rgba(211,179,112,.25)}
  @media (hover:hover) and (pointer:fine){.sr-try:hover{color:#F2D493}}

  .sr :global(.sr-group){margin-top:3.25rem}
  .sr :global(.sr-head){display:flex;align-items:center;gap:.875rem;margin-bottom:.375rem}
  .sr :global(.sr-name){font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#D3B370}
  .sr :global(.sr-rule){flex:1;height:1px;background:rgba(211,179,112,.22)}
  .sr :global(.sr-count){font:italic 400 .9375rem/1 'EB Garamond',Georgia,serif;color:#8D897F}
  .sr :global(.sr-row){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.375rem 1.5rem;align-items:baseline;padding:1rem .875rem;margin:0 -.875rem;border-bottom:1px solid rgba(238,231,215,.08);color:#EEE7D7}
  @media (hover:hover) and (pointer:fine){.sr :global(.sr-row:hover){color:#EEE7D7}}
  .sr :global(.sr-t){font:400 1.3125rem/1.25 Gloock,Georgia,serif}
  .sr :global(.sr-m){font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F;text-align:right}
  .sr :global(.sr-d){grid-column:1 / -1;font:400 1rem/1.45 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}
  .sr :global(.sr-more){margin-top:.875rem;font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border-bottom:1px solid rgba(211,179,112,.6);padding-bottom:.3125rem}

  .sr-none{margin-top:3.5rem;display:flex;flex-direction:column;gap:.875rem}
  .sr-none[hidden]{display:none}
  .sr-none-q{margin:0;font:400 1.5rem/1.4 Gloock,Georgia,serif;color:#F3ECDC}
  .sr-none-p{margin:0;font:400 1.125rem/1.55 'EB Garamond',Georgia,serif;color:#B8B2A5}
  .sr-none-p a{color:#F2D493;border-bottom:1px solid rgba(211,179,112,.4)}

  /* Phones (board 6d): the input sticks under the header (Gloock clamp(30px,
     9vw, 40px), gold underline, × clears) with the "Try" row right under it;
     rows are at least 64px and the whole row is the link. */
  @media (max-width:1023px){
    .sr{display:flex;flex-direction:column}
    .sr-label{order:1}
    .sr-box{order:2;position:sticky;top:var(--head-h);z-index:10;gap:.5rem;padding:1.375rem 0 .625rem;border-bottom-color:#D3B370;transition:top .22s ease}
    .sr-box::before{content:'';position:absolute;z-index:-1;top:0;bottom:1px;left:calc(-1 * var(--gut));right:calc(-1 * var(--gut));background:#070A14;opacity:0;transition:opacity .22s ease}
    .sr-stuck::before{opacity:1}
    .sr-box input{min-height:44px;padding:0;text-overflow:ellipsis}
    .sr-clear{flex:none;min-width:44px;height:44px}
    .sr-clear[hidden]{display:none}
    .sr-tries{order:3;margin-top:1rem}
    .sr-status{order:4}
    [data-groups]{order:5}
    .sr-none{order:6}
    .sr-try{display:inline-flex;align-items:center;min-height:44px;box-sizing:border-box;border-bottom:0;text-decoration:underline;text-decoration-color:rgba(211,179,112,.25);text-underline-offset:.25em}
    .sr :global(.sr-more){display:inline-flex;align-items:flex-end;min-height:44px;box-sizing:border-box}
  }
  @media (max-width:767px){
    .sr{padding-top:0}
    .sr-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .sr-box{margin-top:0}
    .sr-status{display:none}
    .sr-box input{font-size:clamp(1.875rem,9vw,2.5rem)}
    .sr-clear{width:44px;margin-right:-10px;display:grid;place-items:center;font:400 1.5rem/1 'EB Garamond',Georgia,serif;letter-spacing:0;text-transform:none}
    .sr-clear-w{display:none}
    .sr-clear-x{display:inline}
    .sr :global(.sr-group){margin-top:1.5rem}
    .sr :global(.sr-head){margin-bottom:0;padding-bottom:.75rem}
    .sr :global(.sr-rule){visibility:hidden}
    .sr :global(.sr-count){font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase}
    .sr :global(.sr-row){display:flex;flex-direction:column;gap:6px;min-height:64px;box-sizing:border-box;padding:13px 0;margin:0;border-bottom:0;border-top:1px solid rgba(238,231,215,.1)}
    .sr :global(.sr-t){font-size:1.125rem}
    .sr :global(.sr-d){font-size:.9375rem;line-height:1.4}
    .sr :global(.sr-m){order:3;text-align:left}
    .sr :global(.sr-more){display:flex;align-items:center;width:100%;height:44px;margin:0;padding:0;border-bottom:0;border-top:1px solid rgba(238,231,215,.1);letter-spacing:.18em}
  }
  @media (max-width:1023px) and (prefers-reduced-motion:reduce){ .sr-box,.sr-box::before{transition:none} }
</style>

<script>
  // Port of the reference's build, hl, results, onQ, onKey and renderVals.
  type Row = { t: string; u: string; k: string; d: string; m: string; i?: number };
  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-q]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
    const triesEl = root.querySelector<HTMLElement>('[data-tries]')!;
    const groupsEl = root.querySelector<HTMLElement>('[data-groups]')!;
    const noneEl = root.querySelector<HTMLElement>('[data-none]')!;
    const total = statusEl.textContent;
    let idx: [string, Row[]][] | null = null, q = '', act = 0, open: Record<string, boolean> = {}, flat: Row[] = [];
    // XS–S: the first page shows five objects and three of everything else.
    const small = matchMedia('(max-width: 767px)');

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const hl = (t: string, toks: string[]) => {
      const low = t.toLowerCase(), marks = new Array(t.length).fill(false);
      toks.forEach((k) => { let i = low.indexOf(k); while (k && i >= 0) { for (let j = i; j < i + k.length; j++) marks[j] = true; i = low.indexOf(k, i + k.length); } });
      const out: { t: string; m: boolean }[] = [];
      for (let i = 0; i < t.length; i++) { const m = marks[i]; if (out.length && out[out.length - 1].m === m) out[out.length - 1].t += t[i]; else out.push({ t: t[i], m }); }
      return out.map((p) => '<span style="color:' + (p.m ? '#F2D493' : 'inherit') + ';background:' + (p.m ? 'rgba(211,179,112,.14)' : 'transparent') + '">' + esc(p.t) + '</span>').join('');
    };
    const results = () => {
      const toks = q.toLowerCase().split(/\s+/).filter(Boolean);
      if (!toks.length || !idx) return { toks, groups: [] as { name: string; hits: Row[] }[] };
      const groups = idx.map(([name, rows]) => {
        const hits = rows.map((r) => {
          const t = r.t.toLowerCase(), all = (r.t + ' ' + r.k + ' ' + r.d + ' ' + r.m).toLowerCase();
          if (!toks.every((k) => all.includes(k))) return null;
          return { r, s: toks.reduce((a, k) => a + (t.startsWith(k) ? 4 : t.includes(k) ? 2 : 0), 0) };
        }).filter(Boolean).sort((a, b) => b!.s - a!.s).map((h) => h!.r);
        return { name, hits };
      }).filter((g) => g.hits.length);
      return { toks, groups };
    };

    const render = () => {
      const { toks, groups } = results();
      let n = 0; flat = [];
      groupsEl.innerHTML = groups.map((g) => {
        const cap = open[g.name] ? 999 : g.name === 'Objects' ? (small.matches ? 5 : 8) : (small.matches ? 3 : 5), rows = g.hits.slice(0, cap);
        const more = g.hits.length > cap ? 'Show ' + (g.hits.length - cap) + ' more' : '';
        return '<section class="sr-group"><div class="sr-head"><span class="sr-name">' + g.name + '</span><span class="sr-rule"></span><span class="sr-count">' + g.hits.length + (g.hits.length === 1 ? ' result' : ' results') + '</span></div>'
          + rows.map((r) => {
            const i = n++; flat.push(r);
            return '<a href="' + esc(r.u) + '" class="sr-row" data-i="' + i + '" style="background:' + (i === act ? 'rgba(211,179,112,.08)' : 'rgba(211,179,112,0)') + '"><span class="sr-t" style="color:' + (r.i ? '#F2CF85' : '#F3ECDC') + '">' + hl(r.t, toks) + '</span><span class="sr-m">' + esc(r.m) + '</span><span class="sr-d">' + esc(r.d) + '</span></a>';
          }).join('')
          + (more ? '<button type="button" class="sr-more" data-more="' + g.name + '">' + more + '</button>' : '')
          + '</section>';
      }).join('');
      const hitN = groups.reduce((a, g) => a + g.hits.length, 0);
      statusEl.textContent = toks.length ? hitN + (hitN === 1 ? ' match' : ' matches') : total;
      triesEl.hidden = toks.length > 0;
      noneEl.hidden = !(toks.length > 0 && hitN === 0 && idx);
      root.querySelector('[data-none-q]')!.textContent = q;
      clear.hidden = !q;
    };
    // Moving the highlight only repaints the rows.
    const paint = () => groupsEl.querySelectorAll<HTMLElement>('.sr-row').forEach((a) => { a.style.background = +a.dataset.i! === act ? 'rgba(211,179,112,.08)' : 'rgba(211,179,112,0)'; });
    const setQ = (v: string) => { q = v; act = 0; open = {}; if (input.value !== v) input.value = v; render(); };

    input.addEventListener('input', () => setQ(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); act = Math.min(flat.length - 1, act + 1); paint(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); act = Math.max(0, act - 1); paint(); }
      else if (e.key === 'Enter' && flat[act]) { location.href = flat[act].u; }
      else if (e.key === 'Escape') { q = ''; act = 0; input.value = ''; render(); }
    });
    clear.addEventListener('click', () => { q = ''; act = 0; input.value = ''; render(); input.focus(); });
    triesEl.querySelectorAll<HTMLButtonElement>('[data-try]').forEach((b) => b.addEventListener('click', () => { q = b.dataset.try!; act = 0; input.value = q; render(); input.focus(); }));
    groupsEl.addEventListener('mouseover', (e) => {
      const a = (e.target as Element).closest<HTMLElement>('.sr-row');
      if (a && +a.dataset.i! !== act) { act = +a.dataset.i!; paint(); }
    });
    groupsEl.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-more]');
      if (b) { open = { ...open, [b.dataset.more!]: true }; render(); }
    });
    addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input.select(); }
    });
    // The box's backdrop only once the page has scrolled under it.
    const box = root.querySelector<HTMLElement>('.sr-box')!;
    const stuck = () => box.classList.toggle('sr-stuck', scrollY > 2);
    addEventListener('scroll', stuck, { passive: true }); stuck();
    // Scrolling the results by touch drops the keyboard.
    addEventListener('touchmove', (e) => { if (document.activeElement === input && !(e.target as Element).closest?.('.sr-box')) input.blur(); }, { passive: true });
    small.addEventListener('change', () => { if (q) render(); });

    const seed = root.dataset.seed === 'path'
      ? decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() ?? '').replace(/\.html?$/, '').replace(/[-_+]+/g, ' ').trim()
      : new URLSearchParams(location.search).get('q');
    if (seed) { q = seed; input.value = seed; render(); }
    setTimeout(() => input.focus(), 60);
    fetch('/search-index.json').then((r) => r.json()).then((ix: { objects: Row[]; narratives: Row[]; fields: Row[]; pages: Row[] }) => {
      idx = [['Objects', ix.objects], ['Narratives', ix.narratives], ['Fields', ix.fields], ['Pages', ix.pages]];
      // From a missing address, let go of trailing words until something answers.
      if (root.dataset.seed === 'path' && q) {
        const words = q.split(/\s+/);
        while (words.length > 1 && !results().groups.length) { words.pop(); q = words.join(' '); }
        input.value = q;
      }
      render();
    });
  }
</script>
