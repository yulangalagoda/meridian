---
// An archive page: header, the rail beside a reading column, the motto footer.
import NightSky from '../../layouts/NightSky.astro';
import SkyPage from '../SkyPage.astro';
import SiteHeader from '../SiteHeader.astro';
import MottoFooter from '../MottoFooter.astro';
import ArchiveRail from './ArchiveRail.astro';
import type { ArchiveSlug } from './types';
import { breadcrumbs, webPage } from '../seo';

interface Props {
  current: ArchiveSlug;
  title: string;
  description?: string;
  width: 680 | 720 | 760; // the reading column's max-width in the reference
  jsonLd?: object[];
}

const { current, title, description, width } = Astro.props;
const path = `/${current}/`;
const jsonLd = Astro.props.jsonLd ?? [webPage(`${title} — The Meridian`, path, description ?? ''), breadcrumbs([['The Meridian', '/'], [title, path]])];
---

<NightSky title={`${title} · The Meridian`} description={description} jsonLd={jsonLd}>
  <SkyPage depth="50%">
    <SiteHeader current={current === 'about' ? 'about' : undefined} />
    <main class="ap">
      <ArchiveRail current={current} />
      <article class="ap-col" style={`max-width:${width / 16}rem`}>
        <slot />
      </article>
    </main>
    <MottoFooter />
  </SkyPage>
</NightSky>

<style>
  .ap{max-width:73.75rem;margin:0 auto;box-sizing:border-box;padding:clamp(4rem,8vw,7.5rem) var(--gut) clamp(5rem,9vw,8.75rem);display:flex;flex-wrap:wrap;align-items:flex-start;gap:3rem clamp(2.5rem,6vw,6rem)}
  .ap-col{flex:1 1 30rem;min-width:0}
</style>
