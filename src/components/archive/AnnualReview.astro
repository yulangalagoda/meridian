---
// Annual Review: lede, then a year line — each H2 (the year) with the
// paragraphs under it, hung on a fading gold rule with a star per year.
import Lede from './Lede.astro';
import { blockSpans, plainText, renderSpans } from '../../lib/richtext';

interface Props { blocks: any[] }
const { blocks } = Astro.props;

const html = (b: any) => renderSpans(blockSpans(b));
const lede = blocks[0];
const years: { year: string; paras: string[] }[] = [];
for (const b of blocks.slice(1)) {
  if (b.type === 'heading_2') years.push({ year: plainText(blockSpans(b)), paras: [] });
  else if (b.type === 'paragraph' && years.length && blockSpans(b).length) years[years.length - 1].paras.push(html(b));
}
---

<Lede html={html(lede)} after={72} pretty />

<div class="ar-line">
  <span class="ar-rule"></span>
  {years.map((y) => (
    <section class="ar-year">
      <span class="ar-star"></span>
      <h2 class="ar-num">{y.year}</h2>
      {y.paras.map((p) => <p class="ar-text" set:html={p} />)}
    </section>
  ))}
</div>

<style>
  .ar-line{position:relative;padding-left:44px}
  .ar-rule{position:absolute;left:5px;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,rgba(211,179,112,.7),rgba(211,179,112,0))}
  .ar-year{position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:48px}
  .ar-star{position:absolute;left:-44px;top:22px;width:11px;height:11px;border-radius:50%;background:#FFF8E8;box-shadow:0 0 12px 4px rgba(255,240,205,.55)}
  .ar-num{margin:0;font:400 clamp(56px,6vw,84px)/1 Gloock,Georgia,serif;color:#F2D493;font-variant-numeric:tabular-nums}
  .ar-text{margin:0;font:400 21px/1.65 'EB Garamond',Georgia,serif;color:#D9D2C3;text-wrap:pretty}
  .ar-text :global(em){color:#F3ECDC}
</style>
