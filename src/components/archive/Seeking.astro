---
// Seeking: lede; each bold-led paragraph is a numbered want with a dashed ring
// (the archive doesn't hold it yet) and an "I know of one →" mail link whose
// subject names the want; the last plain paragraph is the italic note.
import Lede from './Lede.astro';
import VerificationRing from '../VerificationRing.astro';
import { CONTACT_EMAIL } from './types';
import { blockSpans, renderSpans, splitBoldLead } from '../../lib/richtext';

interface Props { blocks: any[] }
const { blocks } = Astro.props;

const html = (b: any) => renderSpans(blockSpans(b));
const led = (b: any) => (b.type === 'paragraph' ? splitBoldLead(blockSpans(b)) : null);

const lede = blocks[0];
const wants = blocks.filter(led).map((b) => led(b)!);
const notes = blocks.slice(1).filter((b) => b.type === 'paragraph' && blockSpans(b).length && !led(b));
const subject = (lead: string) => encodeURIComponent(`Seeking: ${lead.replace(/\.$/, '')}`);
---

<Lede html={html(lede)} after={56} pretty />

<div class="sk-list">
  {wants.map((w, i) => (
    <div class="sk-want">
      <div class="sk-mark">
        <VerificationRing verified={false} size={14} />
        <span class="sk-num">{String(i + 1).padStart(2, '0')}</span>
      </div>
      <div class="sk-body">
        <h2 class="sk-title">{w.lead}</h2>
        <p class="sk-text" set:html={w.restHtml} />
        <a class="sk-tip" href={`mailto:${CONTACT_EMAIL}?subject=${subject(w.lead)}`}>I know of one →</a>
      </div>
    </div>
  ))}
</div>

{notes.map((b) => <p class="sk-note" set:html={html(b)} />)}

<style>
  .sk-list{display:flex;flex-direction:column;border-bottom:1px solid rgba(238,231,215,.12)}
  .sk-want{display:grid;grid-template-columns:3.5rem minmax(0,1fr);gap:.5rem 1.25rem;padding:2.125rem 0;border-top:1px solid rgba(238,231,215,.12)}
  .sk-mark{display:flex;flex-direction:column;align-items:center;gap:.75rem;padding-top:.375rem}
  .sk-num{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.14em;color:#8D897F}
  .sk-body{display:flex;flex-direction:column;gap:.875rem}
  .sk-title{margin:0;font:400 clamp(1.5rem,2.4vw,1.875rem)/1.15 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .sk-text{margin:0;font:400 1.25rem/1.6 'EB Garamond',Georgia,serif;color:#D9D2C3;text-wrap:pretty}
  .sk-tip{align-self:flex-start;margin-top:.25rem;font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border-bottom:1px solid rgba(211,179,112,.6);padding-bottom:.375rem}
  .sk-note{margin:2.75rem 0 0;font:italic 400 1.1875rem/1.6 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}
  .sk-note :global(a){color:#F2D493;border-bottom:1px solid rgba(211,179,112,.4)}

  /* Below L (board 7b): the number-and-ring column narrows to 40px; body 19/1.6;
     "I know of one →" becomes a 44px row, its subject still filled in. */
  @media (max-width:1023px){
    .sk-want{grid-template-columns:2.5rem minmax(0,1fr);gap:.5rem 1rem}
    .sk-text{font-size:1.1875rem;line-height:1.6}
    .sk-tip{align-self:stretch;display:flex;align-items:center;min-height:44px;box-sizing:border-box;margin-top:.25rem;padding:0;border-bottom:0;border-top:1px solid rgba(238,231,215,.1)}
  }
</style>
