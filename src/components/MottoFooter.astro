---
// Every page ends on the motto. Copy is word for word from the root
// "The Meridian" page in Notion. The references size it per page:
//   archive  archive pages, collection, narratives
//   island   as archive, without the bottom glow
//   timeline larger motto, more air above the credit line
//   object   larger motto, plus links to every archive page
//   home     largest motto, the "no exception" line and the archive links
import Star from './Star.astro';

type Variant = 'archive' | 'island' | 'timeline' | 'object' | 'home';

interface Props {
  variant?: Variant;
}

const { variant = 'archive' } = Astro.props;

const withLinks = variant === 'home' || variant === 'object';
const reveal = withLinks ? { 'data-reveal': '1' } : {};

const ARCHIVE_LINKS: [string, string][] = [
  ['/collecting-policy', 'Collecting Policy'],
  ['/verification-and-provenance', 'Verification & Provenance'],
  ['/seeking', 'Seeking'],
  ['/access-citation-image-use', 'Access, Citation & Image Use'],
  ['/annual-review', 'Annual Review'],
  ['/about', 'About'],
];

---

<footer class:list={['ft', `ft-${variant}`]}>
  <div class="ft-motto" {...reveal}>
    <Star kind="motto" />
    <p class="ft-pali">Vayadhammā saṅkhārā</p>
    <p class="ft-decay">All conditioned things are subject to decay.</p>
    {variant === 'home' && (
      <p class="ft-note">The objects here are no exception; they are on their way there too, simply held for a while, and cared for along the road.</p>
    )}
  </div>
  {withLinks && (
    <nav class="ft-links" aria-label="The Archive">
      {ARCHIVE_LINKS.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  )}
  <div class="ft-credit">The Meridian · the collection of Yulan Galagoda · meridian.yulan.me</div>
</footer>

<style>
  .ft{padding:var(--sec) var(--gut) calc(3.25rem + env(safe-area-inset-bottom));text-align:center;background:radial-gradient(ellipse 60% 70% at 50% 100%,rgba(32,45,100,.4) 0%,rgba(7,10,20,0) 72%)}
  .ft-island{background:none}
  .ft-timeline,.ft-object{padding:clamp(5.625rem,9vw,8.75rem) var(--gut) calc(3.25rem + env(safe-area-inset-bottom))}
  .ft-home{position:relative;padding:clamp(6.875rem,11vw,10.625rem) var(--gut) calc(3.5rem + env(safe-area-inset-bottom))}

  .ft-motto{display:flex;flex-direction:column;align-items:center;gap:1.125rem}
  .ft-home .ft-motto{max-width:47.5rem;margin:0 auto;gap:1.375rem}

  .ft-pali{margin:0;font:italic 400 clamp(2rem,4vw,3.25rem)/1.05 'EB Garamond',Georgia,serif;color:#F3ECDC}
  .ft-timeline .ft-pali,.ft-object .ft-pali{font:italic 400 clamp(2.25rem,4.4vw,3.75rem)/1.05 'EB Garamond',Georgia,serif}
  .ft-home .ft-pali{font:italic 400 clamp(2.625rem,5.4vw,4.75rem)/1.05 'EB Garamond',Georgia,serif}

  .ft-decay{margin:0;font:500 .65625rem/1.6 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#D3B370}
  .ft-note{margin:.375rem 0 0;max-width:33.75rem;font:400 1.1875rem/1.55 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}

  .ft-links{margin:4.5rem auto 0;max-width:68.75rem;display:flex;flex-wrap:wrap;justify-content:center;gap:.875rem 2.25rem;font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#8D897F}
  .ft-home .ft-links{margin:6.25rem auto 0}

  .ft-credit{margin-top:3rem;font:italic 400 .9375rem/1.5 'EB Garamond',Georgia,serif;color:#8D897F}
  .ft-timeline .ft-credit{margin-top:3.5rem}
  .ft-object .ft-credit,.ft-home .ft-credit{margin-top:1.75rem}
</style>
