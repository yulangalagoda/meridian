---
// Shared header: Collection / Narratives / Timeline, the centred THE • MERIDIAN
// logo, The Island / About / Search ⌘K. The current section is gold.
// The references draw it two ways: in normal flow (archive pages, collection,
// narratives, island, search), or laid over a full-bleed hero (home, timeline,
// object, narrative), where it is absolute and its navs don't wrap.
//
// Three modes by width (Responsive System board, 01 Shell):
//   ≥1024     the full header (at L: 76px tall, nav gap 22px, logo 14px in 96 · 24 · 96)
//   768–1023  Menu · logo · Search, labelled, 64px tall
//   <768      two 44px icon buttons and a 13px logo, 56px tall plus the safe area
// Below 1024 the header is sticky (fixed over heroes): after 24px of scroll it
// gets a backdrop, it slides away on scroll down and returns on scroll up, and
// Menu opens the full-screen menu <dialog>. "⌘K" shows only under a fine pointer.
export type Section = 'collection' | 'narratives' | 'timeline' | 'island' | 'about' | 'search';

interface Props {
  current?: Section;
  overlay?: boolean;
  z?: number; // overlay stacking: 6 on home, 20 elsewhere
  passThrough?: boolean; // narrative: only the links take the pointer
  [attr: `data-${string}`]: string;
}

const { current, overlay = false, z = 20, passThrough = false, ...rest } = Astro.props;

const LEFT: [Section, string, string][] = [
  ['collection', '/collection', 'Collection'],
  ['narratives', '/narratives', 'Narratives'],
  ['timeline', '/timeline', 'Timeline'],
];
const RIGHT: [Section, string, string][] = [
  ['island', '/the-island', 'The Island'],
  ['about', '/about', 'About'],
  ['search', '/search', 'Search'],
];
// The menu: the six header routes, then the other five archive pages.
const ROUTES = [...LEFT, ...RIGHT];
const ARCHIVE: [string, string][] = [
  ['/collecting-policy', 'Collecting Policy'],
  ['/verification-and-provenance', 'Verification & Provenance'],
  ['/seeking', 'Seeking'],
  ['/access-citation-image-use', 'Access, Citation & Image Use'],
  ['/annual-review', 'Annual Review'],
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<header
  class:list={['hd', overlay ? 'hd-over' : 'hd-flow', { 'hd-pass': passThrough }]}
  style={overlay ? `--hd-z:${z}` : undefined}
  data-hd
  {...rest}
>
  <button type="button" class="hd-ctl hd-menu" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open>
    <span class="hd-bars" aria-hidden="true"><span></span><span></span></span><span class="hd-lab">Menu</span>
  </button>
  <nav class="hd-nav" aria-label="Primary">
    {LEFT.map(([key, href, label]) => (
      <a href={href} class:list={{ 'hd-on': current === key }} aria-current={current === key ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <a href="/" class="hd-logo" aria-label="The Meridian, home">
    <span class="hd-the">THE</span>
    <span class="hd-dot" aria-hidden="true"></span>
    <span>MERIDIAN</span>
  </a>
  <nav class="hd-nav hd-end" aria-label="Secondary">
    {RIGHT.map(([key, href, label]) => (
      <a href={href} class:list={{ 'hd-on': current === key }} aria-current={current === key ? 'page' : undefined}>{key === 'search' ? <Fragment><span class="hd-k">Search ⌘K</span><span class="hd-nok">Search</span></Fragment> : label}</a>
    ))}
  </nav>
  <a href="/search" class="hd-ctl hd-find" aria-current={current === 'search' ? 'page' : undefined}>
    <span class="hd-lab">Search</span><span class="hd-glass" aria-hidden="true"></span>
  </a>
</header>

<dialog class="mn" id="site-menu" aria-label="Menu" data-menu>
  <div class="hd mn-bar">
    <button type="button" class="hd-ctl mn-x" aria-label="Close menu" data-menu-close>×</button>
    <a href="/" class="hd-logo" aria-label="The Meridian, home">
      <span class="hd-the">THE</span>
      <span class="hd-dot" aria-hidden="true"></span>
      <span>MERIDIAN</span>
    </a>
    <a href="/search" class="hd-ctl hd-find">
      <span class="hd-lab">Search</span><span class="hd-glass" aria-hidden="true"></span>
    </a>
  </div>
  <div class="mn-col">
    <nav class="mn-nav" aria-label="Primary">
      {ROUTES.map(([key, href, label]) => (
        <a href={href} class:list={['mn-route', { 'mn-on': current === key, 'mn-isl': key === 'island' }]} aria-current={current === key ? 'page' : undefined}>
          {label}{current === key && <span class="mn-dot" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>
    <nav class="mn-arch" aria-label="The Archive">
      <span class="mn-arch-h">The Archive</span>
      {ARCHIVE.map(([href, label]) => (
        <a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <p class="mn-motto"><span class="mn-star" aria-hidden="true"></span>Vayadhammā saṅkhārā</p>
  </div>
</dialog>

<style>
  .hd{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;padding:calc(1.75rem + env(safe-area-inset-top)) var(--gut) 1.75rem}
  .hd-flow{gap:1rem}
  .hd-over{position:absolute;top:0;left:0;right:0;z-index:var(--hd-z)}
  .hd-pass{pointer-events:none}
  .hd-pass > *{pointer-events:auto}
  .hd-nav{display:flex;gap:clamp(1rem,2.4vw,2.125rem);font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#B8B2A5}
  .hd-flow .hd-nav{flex-wrap:wrap;gap:.75rem clamp(1rem,2.4vw,2.125rem)}
  .hd-end{justify-self:end}
  .hd-flow .hd-end{justify-content:flex-end}
  .hd-on{color:#D3B370}
  .hd-logo{display:grid;grid-template-columns:7.5rem 1.875rem 7.5rem;align-items:center;font:400 .9375rem/1 Gloock,Georgia,serif;letter-spacing:.42em;color:#F3ECDC}
  .hd-the{text-align:right;margin-right:-.42em}
  .hd-dot{justify-self:center;width:5px;height:5px;border-radius:50%;background:#F6E7C4;box-shadow:0 0 8px 2px rgba(246,231,196,.6)}
  .hd-k{display:none}
  @media (pointer:fine){ .hd-k{display:inline} .hd-nok{display:none} }
  .hd-ctl{display:none}

  /* L: the full header, tightened. */
  @media (min-width:1024px) and (max-width:1279px){
    .hd{box-sizing:border-box;height:calc(4.75rem + env(safe-area-inset-top));padding:env(safe-area-inset-top) var(--gut) 0}
    .hd-nav,.hd-flow .hd-nav{gap:.75rem 1.375rem}
    .hd-logo{grid-template-columns:6rem 1.5rem 6rem;font-size:.875rem;letter-spacing:.4em}
    .hd-the{margin-right:-.4em}
  }

  /* Below L: Menu · logo · Search, sticky, with the backdrop once scrolled. */
  @media (max-width:1023px){
    .hd{box-sizing:border-box;gap:0;border-bottom:1px solid transparent;transition:transform .22s ease,background-color .22s ease,border-color .22s ease}
    .hd-flow{position:sticky;top:0;z-index:30}
    .hd-over{position:fixed;z-index:30}
    .hd-nav{display:none}
    .hd-ctl{display:flex;align-items:center;gap:.75rem;height:44px;font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#EEE7D7}
    .hd-menu{justify-self:start}
    .hd-find{justify-self:end}
    .hd-bars{display:flex;flex-direction:column;gap:6px}
    .hd-bars span{width:20px;height:1px;background:#EEE7D7}
    .hd-glass{position:relative;flex:none;width:13px;height:13px;box-sizing:border-box;border:1px solid #EEE7D7;border-radius:50%}
    .hd-glass::after{content:'';position:absolute;left:10px;top:10px;width:6px;height:1px;background:#EEE7D7;transform:rotate(45deg);transform-origin:0 0}
    .hd-solid{background-color:rgba(7,10,20,.86);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom-color:rgba(238,231,215,.08)}
    .hd-hide{transform:translateY(-100%)}
  }
  @media (min-width:768px) and (max-width:1023px){
    .hd{height:calc(4rem + env(safe-area-inset-top));padding:env(safe-area-inset-top) max(1.75rem,env(safe-area-inset-right)) 0 max(1.75rem,env(safe-area-inset-left))}
    .hd-logo{grid-template-columns:6rem 1.5rem 6rem;font-size:.875rem;letter-spacing:.4em}
    .hd-the{margin-right:-.4em}
  }
  @media (max-width:767px){
    .hd{height:calc(3.5rem + env(safe-area-inset-top));padding:env(safe-area-inset-top) max(.5rem,env(safe-area-inset-right)) 0 max(.5rem,env(safe-area-inset-left));grid-template-columns:44px minmax(0,1fr) 44px}
    .hd-ctl{width:44px;justify-content:center}
    .hd-lab{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .hd-logo{display:flex;justify-self:center;gap:.625rem;font-size:.8125rem;letter-spacing:.36em}
    .hd-the{margin-right:-.36em}
    .hd-dot{width:4px;height:4px}
  }
  @media (prefers-reduced-motion:reduce){ .hd{transition:none} }

  /* The menu: a native <dialog>, the only new surface. */
  .mn{position:fixed;inset:0;box-sizing:border-box;width:100%;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;overflow-y:auto;overscroll-behavior:contain;color:#EEE7D7;background:radial-gradient(ellipse 110% 50% at 50% 0,#141C38 0%,#0B1124 50%,#070A14 100%)}
  .mn[open]{display:flex;flex-direction:column;animation:mn-in .3s ease}
  .mn::backdrop{background:transparent}
  @keyframes mn-in{from{opacity:0}}
  @media (prefers-reduced-motion:reduce){ .mn[open]{animation:none} }
  .mn-bar{flex:none;transition:none}
  .mn-x{width:44px;justify-content:center;font:400 1.875rem/1 'EB Garamond',Georgia,serif;letter-spacing:0;text-transform:none}
  @media (min-width:768px){ .mn-x{margin-left:-12px} }
  .mn-col{flex:1 0 auto;display:flex;flex-direction:column;box-sizing:border-box;width:100%;max-width:calc(32.5rem + 40px);margin:0 auto}
  .mn-nav,.mn-arch{padding:0 max(1.25rem,env(safe-area-inset-right)) 0 max(1.25rem,env(safe-area-inset-left))}
  .mn-nav{margin-top:1.5rem;display:flex;flex-direction:column;border-bottom:1px solid rgba(238,231,215,.1)}
  .mn-route{height:3.75rem;display:flex;align-items:center;gap:.875rem;border-top:1px solid rgba(238,231,215,.1);font:400 1.875rem/1 Gloock,Georgia,serif;color:#F3ECDC}
  .mn-isl{color:#F2CF85}
  .mn-on{color:#D3B370}
  .mn-dot{width:5px;height:5px;border-radius:50%;background:#F6E7C4;box-shadow:0 0 8px 2px rgba(246,231,196,.6)}
  .mn-arch{margin-top:2.125rem;display:flex;flex-direction:column}
  .mn-arch-h{padding-bottom:.5rem;font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#D3B370}
  .mn-arch a{height:44px;display:flex;align-items:center;border-top:1px solid rgba(238,231,215,.07);font:italic 400 1.125rem/1 'EB Garamond',Georgia,serif;color:#B8B2A5}
  .mn-motto{margin:auto 0 0;padding:2.125rem 0 calc(1.875rem + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:center;gap:.75rem;font:italic 400 1.3125rem/1 'EB Garamond',Georgia,serif;color:#F3ECDC}
  .mn-star{flex:none;width:5px;height:5px;border-radius:50%;background:#FFF8E8;box-shadow:0 0 10px 3px rgba(255,248,232,.55)}
  :global(html.mn-lock){overflow:hidden}
</style>

<script>
  // Below 1024: the header gets its backdrop after 24px of scroll, slides away
  // on scroll down and comes back on scroll up. The state is mirrored on <html>
  // (data-head="shown" | "hidden") for anything that sticks under the header.
  // Menu opens the <dialog> (focus trapped by showModal; Esc and × close it),
  // and the page behind is held still while it is open.
  const hd = document.querySelector<HTMLElement>('[data-hd]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const root = document.documentElement;
  const compact = matchMedia('(max-width: 1023px)');

  if (hd) {
    let last = Math.max(0, scrollY), queued = false;
    const setHidden = (hide: boolean) => {
      hd.classList.toggle('hd-hide', hide);
      root.dataset.head = hide ? 'hidden' : 'shown';
    };
    const update = () => {
      queued = false;
      const y = Math.max(0, scrollY);
      if (!compact.matches) { hd.classList.remove('hd-solid'); setHidden(false); last = y; return; }
      hd.classList.toggle('hd-solid', y > 24);
      if (menu?.open) { last = y; return; }
      if (y > last + 2 && y > hd.offsetHeight) setHidden(true);
      else if (y < last - 2 || y <= hd.offsetHeight) setHidden(false);
      last = y;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    compact.addEventListener('change', update);
    hd.addEventListener('focusin', () => setHidden(false));
    update();
  }

  if (menu && opener) {
    const shut = () => { if (menu.open) menu.close(); };
    opener.addEventListener('click', () => {
      menu.showModal();
      root.classList.add('mn-lock');
      opener.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('close', () => {
      root.classList.remove('mn-lock');
      opener.setAttribute('aria-expanded', 'false');
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', shut);
    compact.addEventListener('change', () => { if (!compact.matches) shut(); });
    addEventListener('pageshow', (e) => { if (e.persisted) shut(); });
  }
</script>
