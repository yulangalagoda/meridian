---
// About, from the Notion "About me" page: the first paragraph is the lede, an
// all-italic paragraph is the gold aside, a quote becomes the pull quote.
import ArchivePage from '../components/archive/ArchivePage.astro';
import ArchiveHead from '../components/archive/ArchiveHead.astro';
import { CONTACT_EMAIL } from '../components/archive/types';
import { CURATOR, breadcrumbs, webPage } from '../components/seo';
import { fetchPageBlocks, ABOUT_PAGE_ID } from '../lib/notion';
import { blockSpans, renderSpans } from '../lib/richtext';

const blocks = await fetchPageBlocks(ABOUT_PAGE_ID);

// Runs of paragraphs become one prose block; each quote stands on its own.
type Part = { kind: 'prose'; paras: { cls: string; html: string }[] } | { kind: 'quote'; html: string };
const parts: Part[] = [];
let first = true;
for (const b of blocks) {
  const spans = blockSpans(b);
  if (b.type === 'quote') { parts.push({ kind: 'quote', html: renderSpans(spans) }); continue; }
  if (b.type !== 'paragraph' || !spans.length) continue;
  const italic = spans.every((s: any) => s.annotations?.italic);
  const cls = first ? 'ab-lede' : italic ? 'ab-gold' : '';
  first = false;
  const last = parts[parts.length - 1];
  // The gold aside is italic as a whole paragraph, as in the reference, not an inner <em>.
  const plain = italic ? spans.map((s: any) => ({ ...s, annotations: { ...s.annotations, italic: false } })) : spans;
  const para = { cls, html: renderSpans(plain) };
  if (last?.kind === 'prose') last.paras.push(para);
  else parts.push({ kind: 'prose', paras: [para] });
}

const description = 'About The Meridian and its curator, Yulan Galagoda: what the archive collects, why, and how to get in touch about research, viewing or objects.';
const jsonLd = [
  { ...webPage('About — The Meridian', '/about/', description, 'ProfilePage'), mainEntity: CURATOR },
  breadcrumbs([['The Meridian', '/'], ['About', '/about/']]),
];
---

<ArchivePage current="about" title="About" description={description} width={680} jsonLd={jsonLd}>
  <ArchiveHead eyebrow="About · Yulan Galagoda" title="About me" gap={44} />
  {parts.map((part) =>
    part.kind === 'prose' ? (
      <div class="ab-prose">{part.paras.map((p) => <p class={p.cls || undefined} set:html={p.html} />)}</div>
    ) : (
      <blockquote class="ab-quote" set:html={part.html} />
    )
  )}

  <div class="ab-contact">
    <div class="ab-write">
      <span class="ab-label">Write to YG</span>
      <a href={`mailto:${CONTACT_EMAIL}?subject=The%20Meridian`} class="ab-mail">{CONTACT_EMAIL}</a>
    </div>
    <a href="/seeking" class="ab-seek">What the archive is seeking →</a>
  </div>
</ArchivePage>

<style>
  .ab-prose{font:400 1.3125rem/1.62 'EB Garamond',Georgia,serif;color:#D9D2C3;text-wrap:pretty}
  .ab-prose p{margin:0 0 1.1em}
  .ab-prose p:last-child{margin:0}
  .ab-prose .ab-lede{font-size:1.5625rem;line-height:1.5;color:#F3ECDC}
  .ab-prose .ab-gold{font-style:italic;color:#F2CF85}
  .ab-quote{margin:2.25rem 0 0;padding:2.125rem 0 2.125rem 2.25rem;border-left:1px solid rgba(211,179,112,.6);font:400 clamp(1.875rem,3.4vw,2.625rem)/1.2 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}

  .ab-contact{margin-top:4.5rem;padding-top:1.75rem;border-top:1px solid rgba(238,231,215,.12);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:1.25rem}
  .ab-write{display:flex;flex-direction:column;gap:.75rem}
  .ab-label{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#8D897F}
  .ab-mail{font:400 clamp(1.375rem,2.4vw,1.875rem)/1.1 Gloock,Georgia,serif;color:#F3ECDC}
  .ab-seek{font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#F3ECDC;border-bottom:1px solid rgba(211,179,112,.6);padding-bottom:.4375rem}
</style>
