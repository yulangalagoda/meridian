---
// The Sky Over Time, from the Timeline reference. The sky and the shelves are
// rendered at the start year; the script (a port of the reference's
// componentDidMount, glideTo, togglePlay, down/move/up and renderVals) drives
// the dial, the glide and momentum, play, the star card, routes and shelves.
import NightSky from '../layouts/NightSky.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MottoFooter from '../components/MottoFooter.astro';
import ShelfLabel from '../components/ShelfLabel.astro';
import ObjectCard from '../components/ObjectCard.astro';
import VerificationRing from '../components/VerificationRing.astro';
import Sheet from '../components/Sheet.astro';
import { skyPositions, xr } from '../components/sky/geometry';
import { view, constellationPath, ERAS, Y0, Y1, DEG, START, type TLData, type TLItem } from '../components/timeline/model';
import { getSiteData } from '../lib/notion';
import { ERA_OPTIONS, type Item } from '../lib/types';
import { breadcrumbs, listPage, yearSpan } from '../components/seo';

const { items, narratives } = await getSiteData();
const bare = (id: string) => id.replace(/-/g, '');
const byId = new Map(items.map((it) => [bare(it.id), it]));
const pos = skyPositions(items.map((it) => ({ slug: it.slug, year: it.year ?? 0 })));
const yearOf = (it: Item) => it.year ?? 0;

const tlItems: TLItem[] = items.map((it) => ({
  slug: it.slug, name: it.name, year: yearOf(it),
  rng: [Math.min(it.yearFrom ?? yearOf(it), yearOf(it)), Math.max(it.yearTo ?? yearOf(it), yearOf(it))],
  date: it.dateLabel, origin: it.originCountry, short: it.shortDescription,
  island: it.thread === 'The Island', verified: it.verification === 'Verified', verification: it.verification, featured: it.featured,
  narratives: narratives.filter((n) => n.itemIds.includes(bare(it.id))).map((n) => n.slug),
  pos: pos[it.slug],
}));
const sortedItems = items.slice().sort((a, b) => yearOf(a) - yearOf(b) || a.displayOrder - b.displayOrder);
const data: TLData = {
  items: tlItems,
  sorted: sortedItems.map((it) => it.slug),
  narratives: narratives.map((n) => {
    const its = n.itemIds.map((id) => byId.get(id)).filter(Boolean) as Item[];
    const pts = its.slice().sort((a, b) => yearOf(a) - yearOf(b)).map((it) => [pos[it.slug][0] * 1320, pos[it.slug][1] * 600] as [number, number]);
    return { slug: n.slug, name: n.name, items: its.map((it) => it.slug), d: constellationPath(n.slug, pts), last: Math.max(...its.map(yearOf)) };
  }),
};

const v = view(data, START, null, null);
const ticks = [];
for (let y = Y0; y <= 1980; y++) ticks.push({ a: ((y - Y0) * DEG).toFixed(2) + 'deg', h: y % 50 === 0 ? '24px' : y % 10 === 0 ? '14px' : '6px', c: y % 10 === 0 ? 'rgba(211,179,112,.8)' : 'rgba(238,231,215,.22)', label: y % 10 === 0 ? String(y) : '' });
const marks = tlItems.map((it) => ({ a: ((it.year - Y0) * DEG).toFixed(2) + 'deg', c: it.island ? '#F2CF85' : '#F6F0E2' }));
const eras = ERAS.map((e) => ({ name: e[0], a: (((Math.max(e[1], Y0) + Math.min(e[2], Y1)) / 2 - Y0) * DEG).toFixed(2) + 'deg' }));

const shelves = ERA_OPTIONS.map((e) => {
  const its = sortedItems.filter((it) => it.era === e);
  if (!its.length) return null;
  const a = its[0].year, b = its[its.length - 1].year;
  return { name: e, note: its.length + (its.length === 1 ? ' object · ' : ' objects · ') + (a === b ? a : a + '–' + b), its };
}).filter(Boolean) as { name: string; note: string; its: Item[] }[];

const starStyle = (it: TLItem, s: (typeof v.stars)[number]) =>
  `width:${it.featured ? 7 : it.verified ? 4.5 : 4}px;height:${it.featured ? 7 : it.verified ? 4.5 : 4}px;transform:translate(-50%,-50%) scale(${s.scale});background:${it.island ? '#F2CF85' : '#F6F0E2'};box-shadow:${s.glow};opacity:${s.op}`;
const description = `Every object in The Meridian as a star in the sky over time: wind the dial across ${yearSpan(items)}, watch the narratives form as constellations, and browse the shelves era by era.`;
const jsonLd = [
  listPage('Timeline — The Meridian', '/timeline/', description, sortedItems.map((it) => ({ name: it.name, path: `/collection/${it.slug}/` }))),
  breadcrumbs([['The Meridian', '/'], ['Timeline', '/timeline/']]),
];
---

<NightSky title="Timeline · The Meridian" description={description} jsonLd={jsonLd} legible>
  <div class="tl" data-timeline>
    <section class="tl-stage" data-stage>
      <SiteHeader current="timeline" overlay z={20} />
      <div class="tl-meridian"></div>

      <div class="tl-sky" data-sky style={`z-index:${v.skyZ}`}>
        <div class="tl-pan" data-pan>
        {data.narratives.map((n, i) => (
          <svg viewBox="0 0 1320 600" preserveAspectRatio="none" class="tl-svg" aria-hidden="true">
            <path data-path={n.slug} d={n.d} class="tl-path" style={`opacity:${v.paths[i].op}`} />
          </svg>
        ))}
        {tlItems.map((it, i) => (
          <div class="tl-star" style={`left:${(it.pos[0] * 100).toFixed(3)}%;top:${(it.pos[1] * 100).toFixed(3)}%`}>
            <span class="tl-dot" data-dot style={starStyle(it, v.stars[i])}></span>
            <span class="tl-tag" data-tag hidden={!v.stars[i].tag}>{it.name}</span>
            <button type="button" class="tl-hit" data-pick={it.slug} aria-label={it.name} title={it.name} style={`pointer-events:${v.stars[i].pe};--ring:${v.stars[i].ring}`}></button>
          </div>
        ))}
        </div>
        <div class="tl-sel" data-sel hidden>
          <div class="tl-card" data-card>
            <div class="tl-card-top">
              <span class="tl-card-meta" data-sel-meta></span>
              <button type="button" class="tl-x" data-unpick aria-label="Close">×</button>
            </div>
            <span class="tl-card-name" data-sel-name></span>
            <p class="tl-card-short" data-sel-short></p>
            <span class="tl-card-in" data-sel-in></span>
            <div class="tl-card-foot">
              <span class="tl-card-ver"><span data-sel-ring><VerificationRing verified size={9} /></span><span data-sel-ver></span></span>
              <a href="#" class="tl-card-read" data-sel-href>Read the object →</a>
            </div>
          </div>
        </div>
      </div>

      <button type="button" class="tl-play" data-play>▶ Wind the centuries</button>
      <div class="tl-sides" aria-hidden="true"><span>← Risen</span><span>Still to rise →</span></div>
      <button type="button" class="tl-passbar" data-sheet-open="tl-passing">
        <span class="tl-pb-k"><span class="tl-pb-long">Passing through</span><span class="tl-pb-short">Passing ·</span></span>
        <span class="tl-pb-n"><span data-pass-n>{v.passCount + (v.passCount === 1 ? ' object' : ' objects')}</span> ⌃</span>
      </button>

      <div class="tl-year">
        <span class="tl-year-eye">The sky in</span>
        <span class="tl-year-num" data-year>{v.yearText}</span>
        <span class="tl-year-era"><span data-era>{v.era}</span><span class="tl-risen"> · <span data-risen>{v.risenText}</span></span></span>
      </div>

      <div class="tl-pass">
        <span class="tl-pass-eye" data-pass-title>{v.passTitle}</span>
        {[0, 1, 2, 3].map((k) => {
          const p = v.passing[k];
          return (
            <a href={p ? `/collection/${p.slug}` : '#'} class="tl-pass-item" data-pass-slot hidden={!p}>
              <span class="tl-pass-name">{p?.name}</span>
              <span class="tl-pass-date">{p?.date}</span>
            </a>
          );
        })}
        <span class="tl-pass-more" data-pass-more>{v.passMore}</span>
      </div>

      <div class="tl-dial" data-dial>
        <div class="tl-wheel" data-wheel style={`transform:rotate(${v.wheelRot})`}>
          {ticks.map((t) => (
            <div class="tl-arm" style={`transform:rotate(${t.a}) translateY(-1100px)`}>
              <span class="tl-tick" style={`height:${t.h};background:${t.c}`}></span>
              {t.label && <span class="tl-ticklabel">{t.label}</span>}
            </div>
          ))}
          {marks.map((m) => (
            <div class="tl-arm" style={`transform:rotate(${m.a}) translateY(-1052px)`}><span class="tl-mark" style={`background:${m.c}`}></span></div>
          ))}
          {eras.map((e) => (
            <div class="tl-arm" style={`transform:rotate(${e.a}) translateY(-1020px)`}><span class="tl-eraname">{e.name}</span></div>
          ))}
        </div>
        <div class="tl-pointer"><span></span></div>
        <div class="tl-hint"><span class="tl-hint-dial">Drag the dial · ← → to step a year</span><span class="tl-hint-sky">Drag the dial or the sky</span></div>
      </div>
      {/* Before first paint (the module script runs later): pan mode and the short
          "▶ Wind" label, by the same rules as layout() and panTo() below. */}
      <script is:inline define:vars={{ f0: 0.035 + xr(START) * 0.93 }}>
        var st = document.currentScript.parentElement, sky = st.querySelector('[data-sky]'), pan = st.querySelector('[data-pan]');
        var land = matchMedia('(orientation: landscape) and (max-height: 500px)').matches;
        if (land || matchMedia('(max-width: 767px)').matches) st.querySelector('[data-play]').textContent = '▶ Wind';
        if (matchMedia('(max-width: 1023px)').matches && st.clientWidth - (land ? 64 : 0) < (land ? 700 : 761)) {
          st.classList.add('tl-panmode');
          pan.style.transform = 'translateX(' + (st.clientWidth / 2 - sky.offsetLeft - f0 * pan.offsetWidth).toFixed(1) + 'px)';
        }
      </script>
    </section>

    <Sheet id="tl-star" label="">
      <span class="tls-name" data-ss-name></span>
      <p class="tls-short" data-ss-short></p>
      <span class="tls-in" data-ss-in></span>
      <div class="tls-ver"><span class="tls-ring" data-ss-ring></span><span data-ss-ver></span></div>
      <a class="tls-read" href="#" data-ss-href>Read the object →</a>
    </Sheet>
    <Sheet id="tl-passing" label={v.passTitle}>
      <div class="tlp-list" data-pl></div>
    </Sheet>

    <section class="tl-list">
      <div class="tl-hero">
        <div>
          <div class="tl-eye">The timeline · {items.length} objects</div>
          <h2 class="tl-title">Every object, in the order it was made.</h2>
        </div>
        <p class="tl-intro">Each case wakes when the dial passes its year. Open one to find its star in the sky, or follow a narrative and watch the cases it connects light up together.</p>
      </div>
      <div class="tl-routes">
        <span class="tl-routes-label">Narratives through the sky</span>
        <div class="tl-routes-row" data-routes-row>
        {data.narratives.map((n) => (
          <button type="button" class="tl-route" data-route={n.slug} aria-pressed="false"><span class="tl-route-name">{n.name}</span> <span class="tl-route-count">{n.items.length} objects</span></button>
        ))}
        </div>
      </div>
      <div class="tl-shelves">
        {shelves.map((s) => (
          <div class="tl-shelf">
            <ShelfLabel name={s.name} note={s.note} />
            <div class="tl-grid">
              {s.its.map((it) => (
                <ObjectCard variant="timeline" lit={v.lit[it.slug]} name={it.name} date={it.dateLabel} origin={it.originCountry}
                  verified={it.verification === 'Verified'} island={it.thread === 'The Island'} image={it.primaryImage} alt={it.imageAltText} data-open={it.slug} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <MottoFooter variant="timeline" />
  </div>
  <script type="application/json" id="tl-data" set:html={JSON.stringify(data)} />
</NightSky>

<style>
  .tl{position:relative;background:transparent;color:#EEE7D7;overflow-x:clip}
  .tl-stage{position:relative;height:max(100svh,760px);overflow:hidden;background:radial-gradient(ellipse 75% 65% at 50% 38%,rgba(40,55,110,.4) 0%,rgba(17,28,60,.4) 48%,rgba(7,10,20,0) 100%);user-select:none}
  .tl-meridian{position:absolute;left:50%;top:0;bottom:0;width:1px;margin-left:-0.5px;z-index:3;background:linear-gradient(to bottom,rgba(211,179,112,0),rgba(211,179,112,.5) 14%,rgba(211,179,112,.7) 100%);pointer-events:none}

  .tl-sky{position:absolute;left:4%;right:4%;top:6rem;bottom:210px;pointer-events:none}
  .tl-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
  .tl-path{fill:none;stroke:rgba(232,206,150,.5);stroke-width:1;vector-effect:non-scaling-stroke;transition:opacity 1.2s}
  .tl-star{position:absolute;width:0;height:0}
  .tl-dot{position:absolute;left:0;top:0;border-radius:50%;transition:opacity .9s,transform .9s cubic-bezier(.16,1,.3,1),box-shadow .6s}
  .tl-tag{position:absolute;left:12px;top:-7px;width:max-content;max-width:13.75rem;font:400 .875rem/1.2 Gloock,Georgia,serif;color:#F3ECDC;text-shadow:0 0 12px #070A14,0 0 4px #070A14;pointer-events:none}
  .tl-tag[hidden]{display:none}
  .tl-hit{position:absolute;left:-14px;top:-14px;width:28px;height:28px;border-radius:50%;box-shadow:var(--ring);transition:box-shadow .3s}
  @media (hover:hover) and (pointer:fine){.tl-hit:hover{box-shadow:inset 0 0 0 1px rgba(211,179,112,.7)}}

  .tl-sel{position:absolute;z-index:8;width:0;height:0}
  .tl-sel[hidden]{display:none}
  .tl-card{position:absolute;left:0;top:0;pointer-events:auto;width:18.75rem;box-sizing:border-box;padding:1.25rem 1.375rem 1.125rem;background:rgba(11,17,36,.96);border:1px solid rgba(211,179,112,.45);box-shadow:0 24px 60px -20px #000;display:flex;flex-direction:column;gap:.625rem}
  .tl-card-top{display:flex;justify-content:space-between;align-items:baseline;gap:.75rem}
  .tl-card-meta{font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#D3B370}
  .tl-x{font:400 1.125rem/1 'EB Garamond',Georgia,serif;color:#8D897F}
  @media (hover:hover) and (pointer:fine){.tl-x:hover{color:#F3ECDC}}
  .tl-card-name{font:400 1.3125rem/1.15 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .tl-card-short{margin:0;font:400 1rem/1.45 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}
  .tl-card-in{font:italic 400 .9375rem/1.35 'EB Garamond',Georgia,serif;color:#8D897F}
  .tl-card-in[hidden]{display:none}
  .tl-card-foot{display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding-top:.75rem;border-top:1px solid rgba(238,231,215,.1)}
  .tl-card-ver{display:inline-flex;align-items:center;gap:.5rem;font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#B8B2A5}
  .tl-card-ver > span:first-child{display:contents}
  .tl-card-read{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border-bottom:1px solid rgba(211,179,112,.6);padding-bottom:.3125rem}

  .tl-play{position:absolute;left:50%;top:6rem;z-index:5;transform:translateX(-50%);display:flex;align-items:center;gap:.625rem;padding:.625rem 1rem;background:#0B1124;border:1px solid rgba(211,179,112,.5);font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#F3ECDC}
  @media (hover:hover) and (pointer:fine){.tl-play:hover{border-color:#D3B370}}

  .tl-year{position:absolute;left:var(--gut);bottom:44px;z-index:6;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
  .tl-year-eye{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#D3B370}
  .tl-year-num{font:400 clamp(5.25rem,9vw,8.5rem)/.9 Gloock,Georgia,serif;color:#F3ECDC;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
  .tl-year-era{font:italic 400 1.1875rem/1.3 'EB Garamond',Georgia,serif;color:#B8B2A5}

  .tl-pass{position:absolute;right:var(--gut);bottom:44px;z-index:6;width:min(20rem,26vw);display:flex;flex-direction:column;gap:.625rem;text-align:right}
  .tl-pass-eye{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#D3B370}
  .tl-pass-item{display:flex;flex-direction:column;gap:.1875rem;padding:.5rem 0;border-top:1px solid rgba(238,231,215,.12)}
  .tl-pass-item[hidden]{display:none}
  .tl-pass-name{font:400 1.0625rem/1.2 Gloock,Georgia,serif;color:#F3ECDC}
  .tl-pass-date{font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .tl-pass-more{font:italic 400 1rem/1.3 'EB Garamond',Georgia,serif;color:#8D897F}

  .tl-dial{position:absolute;left:0;right:0;bottom:0;height:210px;z-index:4;cursor:grab;touch-action:pan-y;-webkit-mask-image:linear-gradient(90deg,rgba(0,0,0,0) 0px,rgba(0,0,0,0) min(400px,34%),#000 min(520px,42%),#000 calc(100% - min(520px,42%)),rgba(0,0,0,0) calc(100% - min(400px,34%)),rgba(0,0,0,0) 100%);mask-image:linear-gradient(90deg,rgba(0,0,0,0) 0px,rgba(0,0,0,0) min(400px,34%),#000 min(520px,42%),#000 calc(100% - min(520px,42%)),rgba(0,0,0,0) calc(100% - min(400px,34%)),rgba(0,0,0,0) 100%)}
  .tl-wheel{position:absolute;left:50%;top:60px;width:2200px;height:2200px;margin-left:-1100px;border-radius:50%;background:radial-gradient(circle at 50% 50%,#0B1124 0%,#090D1A 96%,#0E1430 100%);box-shadow:0 -1px 0 rgba(211,179,112,.4),0 -30px 80px rgba(20,28,56,.5);transition:none}
  .tl-arm{position:absolute;left:50%;top:50%;width:0;height:0}
  .tl-tick{position:absolute;left:-0.5px;top:0;width:1px}
  .tl-ticklabel{position:absolute;left:0;top:26px;transform:translateX(-50%);font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#8D897F}
  .tl-mark{position:absolute;left:-3px;top:-3px;width:6px;height:6px;border-radius:50%;box-shadow:0 0 8px 2px rgba(255,240,205,.35)}
  .tl-eraname{position:absolute;left:0;top:0;transform:translateX(-50%);font:italic 400 .9375rem/1 'EB Garamond',Georgia,serif;color:#B8B2A5;white-space:nowrap}
  .tl-pointer{position:absolute;left:50%;top:44px;width:0;height:0;pointer-events:none}
  .tl-pointer span{position:absolute;left:-6px;top:0;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #D3B370}
  .tl-hint{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F;white-space:nowrap;pointer-events:none}

  .tl-list{max-width:77.5rem;margin:0 auto;box-sizing:border-box;padding:clamp(5.5rem,9vw,8.125rem) var(--gut) var(--sec)}
  .tl-hero{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22.5rem),1fr));gap:1.5rem 3rem;align-items:end;margin-bottom:2.5rem}
  .tl-eye{font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
  .tl-title{margin:1.125rem 0 0;font:400 clamp(2.125rem,4vw,3.5rem)/1.06 Gloock,Georgia,serif;color:#F3ECDC}
  .tl-intro{margin:0;justify-self:end;max-width:27.5rem;font:400 1.125rem/1.55 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}
  .tl-routes{display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem 1.625rem;padding:1.125rem 0 1.375rem;border-top:1px solid rgba(238,231,215,.12);border-bottom:1px solid rgba(238,231,215,.12);margin-bottom:3.5rem}
  .tl-routes-label{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}
  .tl-route{display:inline-flex;align-items:baseline;gap:.375rem;white-space:nowrap;font:italic 400 1.125rem/1.5 'EB Garamond',Georgia,serif;color:#EEE7D7;border-bottom:1px solid rgba(211,179,112,.25);transition:color .4s,border-color .4s}
  @media (hover:hover) and (pointer:fine){.tl-route:hover{color:#F2D493}}
  .tl-route[aria-pressed='true']{color:#F2D493;border-bottom-color:#D3B370}
  .tl-route-count{font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;font-style:normal;letter-spacing:.1em;color:#8D897F}
  .tl-routes-row{display:contents}
  .tl-shelves{display:flex;flex-direction:column;gap:clamp(3.5rem,6vw,5.25rem)}
  .tl-shelf{display:flex;flex-direction:column;gap:1.375rem}
  .tl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,13.125rem),1fr));gap:clamp(1.125rem,2.2vw,1.875rem)}

  @media (prefers-reduced-motion: reduce) {
    .tl-dot,.tl-path,.tl-hit,.tl-route{transition:none}
  }

  /* Short screens: the section floor drops to 640 and the dial to 160. */
  @media (max-height:760px){
    .tl-stage{height:max(100svh,640px)}
    .tl-dial{height:160px}
    .tl-sky{bottom:160px}
  }

  .tl-pan{position:absolute;inset:0}
  .tl-sides,.tl-passbar,.tl-hint-sky,.tl-pb-short{display:none}

  /* L (Responsive System board, 3c): the shipped layout with the side panels at
     min(260px, 24vw); the dial's clear window is tied to them. */
  @media (min-width:1024px) and (max-width:1279px){
    .tl{--panel:min(16.25rem,24vw)}
    .tl-pass{width:var(--panel)}
