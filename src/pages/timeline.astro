</style>

<script>
  import { view, clamp, Y0, Y1, DEG, R, START, type TLData } from '../components/timeline/model';
  import { xr } from '../components/sky/geometry';
  import { MQ } from '../components/responsive';
  import { openSheet, closeSheet } from '../components/sheet';

  const root = document.querySelector<HTMLElement>('[data-timeline]');
  const json = document.getElementById('tl-data');
  if (root && json) {
    const D: TLData = JSON.parse(json.textContent ?? '{}');
    const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ppy = (R * DEG * Math.PI) / 180;
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const stage = q('[data-stage]'), sky = q('[data-sky]'), wheel = q('[data-wheel]'), dial = q('[data-dial]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const tags = [...root.querySelectorAll<HTMLElement>('[data-tag]')];
    const hits = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const paths = [...root.querySelectorAll<SVGPathElement>('[data-path]')];
    const slots = [...root.querySelectorAll<HTMLAnchorElement>('[data-pass-slot]')];
    const routes = [...root.querySelectorAll<HTMLButtonElement>('[data-route]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-open]')];
    const playBtn = q<HTMLButtonElement>('[data-play]');
    const selBox = q('[data-sel]'), selCard = q('[data-card]');
    const ringEl = q('[data-sel-ring] span');
    const pan = q('[data-pan]');
    const passN = q('[data-pass-n]'), passbar = q('.tl-passbar');
    const starSheet = document.getElementById('tl-star') as HTMLDialogElement;
    const passSheet = document.getElementById('tl-passing') as HTMLDialogElement;
    const bySlug = new Map(D.items.map((it) => [it.slug, it]));

    // Modes (Responsive System board, 03). Pan mode whenever the sky box would be
    // narrower than 700px; sheets on phones, landscape phones and touch below L.
    const phone = matchMedia(MQ.belowM), compact = matchMedia(MQ.belowL), coarse = matchMedia(MQ.coarse);
    // From XXL the stars are drawn 1.15 times larger (board, 08).
    const land = matchMedia(MQ.landscapePhone), huge = matchMedia(MQ.xxl);
    let panMode = false;
    const sheetMode = () => phone.matches || land.matches || (compact.matches && coarse.matches);
    const windLabel = () => (phone.matches || land.matches ? '▶ Wind' : '▶ Wind the centuries');
    const layout = () => {
      panMode = compact.matches && stage.clientWidth - (land.matches ? 64 : 0) < (land.matches ? 700 : 761);
      stage.classList.toggle('tl-panmode', panMode);
      if (!playing) playBtn.textContent = windLabel();
      // Landscape: "Passing · N ⌃" sits 14px left of the Wind button.
      passbar.style.right = land.matches ? stage.clientWidth - playBtn.offsetLeft + 14 + 'px' : '';
    };

    let Y = START, playing = false, pick: string | null = null, route: string | null = null;
    let formed = new Set(D.narratives.filter((p) => p.last <= Y).map((p) => p.slug));
    let tw = 0, playRaf = 0, rq = 0;

    // popY: keep the card between the header and the dial.
    const popY = (fy: number) => {
      const H = sky.offsetHeight || 450, sy = fy * H, ch = 350;
      const top = Math.max(-16, Math.min(H + 150 - ch, sy - ch * 0.4));
      return Math.round(top - sy);
    };

    // In pan mode the drawing slides so x(year) sits on the meridian line.
    const panTo = () => {
      if (!panMode) { pan.style.transform = ''; return; }
      const w = pan.offsetWidth, x = (0.035 + xr(clamp(Y)) * 0.93) * w;
      pan.style.transform = 'translateX(' + (stage.clientWidth / 2 - sky.offsetLeft - x).toFixed(1) + 'px)';
    };
    // Passing tags that would overlap stack downward by the height of the tag above;
    // one that would run off the right edge sits to the left of its star instead.
    // Both are transforms, so the page doesn't shift.
    const stackTags = () => {
      tags.forEach((t) => { t.style.translate = ''; t.classList.remove('tl-tag-l'); });
      if (!compact.matches) return;
      const edge = stage.getBoundingClientRect().right - 8;
      const shown = tags.filter((t) => !t.hidden).map((t) => {
        const r = t.getBoundingClientRect(), flip = r.right > edge;
        if (flip) t.classList.add('tl-tag-l');
        return { t, flip, r: flip ? new DOMRect(r.left - r.width - 24, r.top, r.width, r.height) : r };
      }).sort((a, b) => a.r.top - b.r.top);
      const placed: DOMRect[] = [];
      shown.forEach(({ t, flip, r }) => {
        let dy = 0;
        for (const p of placed) if (r.left < p.right && r.right > p.left && r.top + dy < p.bottom && r.bottom + dy > p.top) dy = p.bottom - r.top;
        if (dy || flip) t.style.translate = (flip ? 'calc(-100% - 24px) ' : '0 ') + dy.toFixed(1) + 'px';
        placed.push(new DOMRect(r.left, r.top + dy, r.width, r.height));
      });
    };

    const render = () => {
      const v = view(D, Y, pick, route);
      panTo();
      wheel.style.transform = 'rotate(' + v.wheelRot + ')';
      sky.style.zIndex = String(v.skyZ);
      q('[data-year]').textContent = v.yearText;
      q('[data-era]').textContent = v.era;
      q('[data-risen]').textContent = v.risenText;
      q('[data-pass-title]').textContent = v.passTitle;
      // Below L the list shows three rows.
      q('[data-pass-more]').textContent = compact.matches && v.passCount > 3 && !land.matches ? 'and ' + (v.passCount - 3) + ' more' : v.passMore;
      passN.textContent = v.passCount + (v.passCount === 1 ? ' object' : ' objects');
      slots.forEach((a, k) => {
        const p = v.passing[k];
        a.hidden = !p;
        if (p) { a.href = '/collection/' + p.slug; a.children[0].textContent = p.name; a.children[1].textContent = p.date; }
      });
      D.items.forEach((it, i) => {
        const s = v.stars[i], dot = dots[i];
        dot.style.opacity = String(s.op);
        dot.style.transform = 'translate(-50%,-50%) scale(' + (huge.matches ? s.scale * 1.15 : s.scale) + ')';
        dot.style.boxShadow = s.glow;
        tags[i].hidden = !s.tag;
        hits[i].style.pointerEvents = s.pe;
        hits[i].style.setProperty('--ring', s.ring);
      });
      D.narratives.forEach((n, i) => {
        paths[i].style.opacity = String(v.paths[i].op);
        if (v.formed.has(n.slug) && !formed.has(n.slug) && !reduced) {
          paths[i].animate([{ opacity: 0, strokeWidth: 3 }, { opacity: 1, strokeWidth: 2, offset: 0.4 }, { opacity: 0.9, strokeWidth: 1 }], { duration: 1600, easing: 'ease-out' });
        }
      });
      formed = v.formed;
      routes.forEach((b, i) => b.setAttribute('aria-pressed', v.routeOn[i] ? 'true' : 'false'));
      cards.forEach((c) => c.style.setProperty('--lit', String(v.lit[c.dataset.open!])));

      const it = v.sel;
      selBox.hidden = !it || sheetMode();
      if (it && sheetMode()) fillSheet(it, v.selNames);
      else if (!it && starSheet.open) closeSheet(starSheet);
      if (it && !sheetMode()) {
        selBox.style.left = (it.pos[0] * 100).toFixed(3) + '%';
        selBox.style.top = (it.pos[1] * 100).toFixed(3) + '%';
        selCard.style.transform = 'translate(' + (it.pos[0] > 0.62 ? 'calc(-100% - 22px)' : '22px') + ',' + popY(it.pos[1]) + 'px)';
        q('[data-sel-meta]').textContent = it.date + ' · ' + it.origin;
        const nm = q('[data-sel-name]'); nm.textContent = it.name; nm.style.color = it.island ? '#F2CF85' : '#F3ECDC';
        q('[data-sel-short]').textContent = it.short;
        const inEl = q('[data-sel-in]'); inEl.hidden = !v.selNames.length; inEl.textContent = 'In ' + v.selNames.join(' · ');
        q('[data-sel-ver]').textContent = it.verification;
        if (ringEl) ringEl.style.borderStyle = it.verified ? 'solid' : 'dashed';
        q<HTMLAnchorElement>('[data-sel-href]').href = '/collection/' + it.slug;
      }
      stackTags();
    };

    // The star sheet (board 3b): the card's content in the same order. While it
    // is open the sky compresses above it and the year shrinks to one line.
    const fillSheet = (it: (typeof D.items)[number], names: string[]) => {
      starSheet.querySelector('.bs-label')!.textContent = it.date + ' · ' + it.origin;
      const nm = starSheet.querySelector<HTMLElement>('[data-ss-name]')!; nm.textContent = it.name; nm.style.color = it.island ? '#F2CF85' : '#F3ECDC';
      starSheet.querySelector('[data-ss-short]')!.textContent = it.short;
      starSheet.querySelector('[data-ss-in]')!.textContent = names.length ? 'In ' + names.join(' · ') : '';
      starSheet.querySelector<HTMLElement>('[data-ss-ring]')!.style.borderStyle = it.verified ? 'solid' : 'dashed';
      starSheet.querySelector('[data-ss-ver]')!.textContent = it.verification;
      starSheet.querySelector<HTMLAnchorElement>('[data-ss-href]')!.href = '/collection/' + it.slug;
      if (!starSheet.open) { openSheet(starSheet); squeeze(); }
    };
    const squeeze = () => {
      stage.classList.add('tl-sheeted');
      const panel = starSheet.querySelector<HTMLElement>('[data-sheet-panel]')!;
      const below = Math.max(0, stage.getBoundingClientRect().bottom - innerHeight);
      sky.style.bottom = (panel.offsetHeight + 24 + below).toFixed(0) + 'px';
      panTo(); stackTags();
    };
    starSheet.addEventListener('sheet:close', () => {
      stage.classList.remove('tl-sheeted'); sky.style.bottom = '';
      if (pick) { pick = null; render(); }
    });

    // The "Passing through" sheet: every object passing through the year.
    passSheet.addEventListener('sheet:open', () => {
      const v = view(D, Y, pick, route);
      passSheet.querySelector('.bs-label')!.textContent = v.passTitle;
      const list = passSheet.querySelector<HTMLElement>('[data-pl]')!;
      list.replaceChildren(...(v.passAll.length ? v.passAll.map((p) => {
        const a = document.createElement('a'); a.href = '/collection/' + p.slug;
        const n = document.createElement('span'); n.className = 'tlp-name'; n.textContent = p.name;
        const d = document.createElement('span'); d.className = 'tlp-date'; d.textContent = p.date;
        a.append(n, d); return a;
      }) : [Object.assign(document.createElement('p'), { className: 'tlp-none', textContent: v.passMore })]));
    });

    const setY = (y: number) => { Y = y; render(); };
    const stopPlay = () => {
      if (playRaf) { cancelAnimationFrame(playRaf); playRaf = 0; }
      if (playing) { playing = false; playBtn.textContent = windLabel(); }
    };
    const glideTo = (target: number) => {
      cancelAnimationFrame(tw); stopPlay();
      target = clamp(target);
      const from = Y, t0 = performance.now(), dur = reduced ? 1 : Math.min(1600, 500 + Math.abs(target - from) * 6);
      const f = (now: number) => {
        const k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
        setY(from + (target - from) * e);
        if (k < 1) tw = requestAnimationFrame(f);
      };
      tw = requestAnimationFrame(f);
    };
    const togglePlay = () => {
      if (playing) { stopPlay(); return; }
      cancelAnimationFrame(tw);
      let y = Y >= Y1 - 1 ? Y0 : Y, last = performance.now();
      playing = true; playBtn.textContent = '❚❚ Pause'; setY(y);
      const f = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000); last = now;
        const near = D.items.some((it) => Math.abs(it.year - y) <= 3);
        y = Math.min(Y1, y + dt * (near ? 6 : 42));
        setY(y);
        if (y < Y1) playRaf = requestAnimationFrame(f);
        else { playRaf = 0; playing = false; playBtn.textContent = windLabel(); }
      };
      playRaf = requestAnimationFrame(f);
    };
    playBtn.addEventListener('click', togglePlay);

    // Stars and the card. On touch below L a tap goes to the nearest risen star
    // within 22px (44px hit areas; where they overlap, the nearest centre wins).
    let dragged = 0;
    sky.addEventListener('click', (e) => {
      if (!(compact.matches && coarse.matches)) return;
      e.stopPropagation(); e.preventDefault();
      if (performance.now() - dragged < 250) return;
      let best: string | null = null, bd = 22;
      hits.forEach((h) => {
        if (h.style.pointerEvents === 'none') return;
        const r = h.getBoundingClientRect(), d = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
        if (d <= bd) { bd = d; best = h.dataset.pick!; }
      });
      if (best) { pick = pick === best ? null : best; render(); }
    }, true);
    hits.forEach((b) => b.addEventListener('click', () => { pick = pick === b.dataset.pick ? null : b.dataset.pick!; render(); }));
    q('[data-unpick]').addEventListener('click', () => { pick = null; render(); });

    // Keys: Esc closes the card; ← → step a year (Shift: ten) while the sky is in view.
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && pick) { pick = null; render(); return; }
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      if (stage.getBoundingClientRect().bottom < 100) return;
      e.preventDefault();
      glideTo(Math.round(Y) + (e.key === 'ArrowRight' ? 1 : -1) * (e.shiftKey ? 10 : 1));
    });

    // The dial: drag with pointer capture, then momentum and a glide to a whole year.
    let drag: { x: number; Y: number; lx: number; lt: number; v: number } | null = null, yy = Y;
    dial.addEventListener('pointerdown', (e) => {
      cancelAnimationFrame(tw); stopPlay(); yy = Y;
      drag = { x: e.clientX, Y, lx: e.clientX, lt: performance.now(), v: 0 };
      try { dial.setPointerCapture(e.pointerId); } catch (err) {}
    });
    dial.addEventListener('pointermove', (e) => {
      const d = drag; if (!d) return;
      const now = performance.now(); d.v = (e.clientX - d.lx) / Math.max(1, now - d.lt); d.lx = e.clientX; d.lt = now;
      yy = clamp(d.Y - (e.clientX - d.x) / ppy);
      if (!rq) rq = requestAnimationFrame(() => { rq = 0; setY(yy); });
    });
    const up = () => {
      const d = drag; if (!d) return; drag = null;
      cancelAnimationFrame(rq); rq = 0; setY(yy);
      const t = Math.round(clamp(yy - (d.v * 260) / ppy));
      setTimeout(() => glideTo(t), 0);
    };
    dial.addEventListener('pointerup', up);
    dial.addEventListener('pointercancel', up);

    // Pan mode: dragging the sky sideways scrubs the year with the dial's ppy and
    // momentum (vertical swipes still scroll: touch-action pan-y). A drag starts
    // past 6px, so a tap still lands on a star.
    let pre: { x: number; id: number } | null = null;
    sky.addEventListener('pointerdown', (e) => { if (panMode) pre = { x: e.clientX, id: e.pointerId }; });
    sky.addEventListener('pointermove', (e) => {
      if (!panMode) return;
      if (pre && !drag && Math.abs(e.clientX - pre.x) > 6) {
        cancelAnimationFrame(tw); stopPlay(); yy = Y;
        drag = { x: pre.x, Y, lx: e.clientX, lt: performance.now(), v: 0 };
        try { sky.setPointerCapture(pre.id); } catch (err) {}
      }
      const d = drag; if (!d || !pre) return;
      const now = performance.now(); d.v = (e.clientX - d.lx) / Math.max(1, now - d.lt); d.lx = e.clientX; d.lt = now;
      yy = clamp(d.Y - (e.clientX - d.x) / ppy);
      if (!rq) rq = requestAnimationFrame(() => { rq = 0; setY(yy); });
    });
    const skyUp = () => { if (pre && drag) { dragged = performance.now(); up(); } pre = null; };
    sky.addEventListener('pointerup', skyUp);
    sky.addEventListener('pointercancel', skyUp);

    // Landscape phones: the header steps aside while the sky fills the screen and
    // comes back on any upward scroll.
    let lastY = scrollY;
    const skyFill = () => {
      const up = scrollY < lastY; lastY = scrollY;
      document.documentElement.classList.toggle('tl-skyfill', land.matches && !up && scrollY < stage.offsetTop + stage.offsetHeight - innerHeight + 2);
    };
    addEventListener('scroll', skyFill, { passive: true });
    [phone, compact, coarse, land, huge].forEach((m) => m.addEventListener('change', () => { layout(); skyFill(); render(); }));
    new ResizeObserver(() => { layout(); render(); }).observe(stage);
    layout(); skyFill();
    // Below L the passing tags show once they've been stacked with the real fonts,
    // so they don't jump when the fonts arrive.
    const tagsReady = () => { layout(); render(); stage.classList.add('tl-tags-ready'); };
    if (document.fonts) document.fonts.ready.then(tagsReady); else tagsReady();

    // Routes and shelves.
    // Below L the active route scrolls into view in its row.
    const routesRow = q('[data-routes-row]');
    routes.forEach((b) => b.addEventListener('click', () => {
      route = route === b.dataset.route ? null : b.dataset.route!; render();
      if (!route || !compact.matches) return;
      const rr = routesRow.getBoundingClientRect(), br = b.getBoundingClientRect(), pad = parseFloat(getComputedStyle(routesRow).paddingLeft);
      if (br.left < rr.left + pad || br.right > rr.left + rr.width * 0.8) routesRow.scrollTo({ left: routesRow.scrollLeft + br.left - rr.left - pad, behavior: reduced ? 'auto' : 'smooth' });
    }));
    cards.forEach((c) => c.addEventListener('click', () => {
      const slug = c.dataset.open!, it = D.items.find((x) => x.slug === slug)!;
      window.scrollTo({ top: stage.offsetTop, behavior: reduced ? 'auto' : 'smooth' });
      pick = slug; render();
      if (it.year > Y) glideTo(it.year);
    }));

    render();
  }
</script>
