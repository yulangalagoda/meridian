---
// An object, from the Object - Taprobana reference (the template for every
// object page): the framed plate with "Inspect the details", the detail images,
// the title block, the sticky record beside the numbered story with its
// reading-progress star, then the object's constellations, its neighbours in
// time and its citation. Text is word for word from the item's Notion fields
// and page.
import NightSky from '../../layouts/NightSky.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MottoFooter from '../../components/MottoFooter.astro';
import VerificationRing from '../../components/VerificationRing.astro';
import ObjectBody from '../../components/object/ObjectBody.astro';
import { CONTACT_EMAIL } from '../../components/archive/types';
import { skyPositions, glyph } from '../../components/sky/geometry';
import { getSiteData, fetchPageBlocks } from '../../lib/notion';
import { responsive } from '../../lib/images';
import type { Item } from '../../lib/types';
import { objectData } from '../../components/seo';

export async function getStaticPaths() {
  const { items } = await getSiteData();
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const { items, narratives } = await getSiteData();
const blocks = await fetchPageBlocks(item.id);

const verified = item.verification === 'Verified';
const island = item.thread === 'The Island';
const bare = (id: string) => id.replace(/-/g, '');
const byId = new Map(items.map((it) => [bare(it.id), it]));

// Constellations this star belongs to.
const pos = skyPositions(items.map((it) => ({ slug: it.slug, year: it.year ?? 0 })));
const years = Object.fromEntries(items.map((it) => [it.slug, it.year ?? 0]));
const cons = narratives
  .filter((n) => n.itemIds.includes(bare(item.id)))
  .map((n) => {
    const its = n.itemIds.map((id) => byId.get(id)).filter(Boolean) as Item[];
    const ys = its.map((it) => it.year ?? 0);
    return { slug: n.slug, name: n.name, premise: n.premise, meta: n.itemIds.length + ' objects · ' + Math.min(...ys) + '–' + Math.max(...ys), ...glyph(pos, years, its.map((it) => it.slug), item.slug) };
  });

// Neighbours in time, and the rest of the Island thread.
const sorted = items.slice().sort((a, b) => (a.year ?? 0) - (b.year ?? 0) || a.displayOrder - b.displayOrder);
const at = sorted.indexOf(item);
const earlier = at > 0 ? sorted[at - 1] : null;
const later = at < sorted.length - 1 ? sorted[at + 1] : null;
const alsoIsland = island ? items.filter((it) => it.thread === 'The Island' && it.slug !== item.slug) : [];

const citation = `${item.name}, The Meridian, collection of Yulan Galagoda, meridian.yulan.me/collection/${item.slug}`;
const mail = (subject: string) => `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`;
const gallery = item.galleryImages.map((src, i) => ({ src, alt: item.galleryCaptions[i] ?? item.name, caption: item.galleryCaptions[i] ?? '' }));
// The touch viewer's images: the primary, then the detail images.
const shots = [
  ...(item.primaryImage ? [{ src: item.primaryImage, alt: item.imageAltText || item.name, name: 'Primary' }] : []),
  ...gallery.map((g, i) => ({ src: g.src, alt: g.alt, name: g.caption || `Detail ${i + 1}` })),
];
const hots = item.primaryImage ? item.details : [];
// Responsive candidates. The plate (29.5:20.5) is at most 980px, wider with the root
// size on XXL / 3XL; a detail tile (3:2) 220px on phones and about 320px above; a
// thumbnail 56px square. The viewer keeps the full-size original for zooming and
// loads it when opened.
const plateImg = await responsive(item.primaryImage, [['(min-width: 3200px)', '1225px'], ['(min-width: 2400px)', '1100px'], [null, 'min(100vw, 980px)']], 29.5 / 20.5);
const detailImgs = await Promise.all(gallery.map((g) => responsive(g.src, [['(max-width: 767px)', '220px'], ['(min-width: 2400px)', '400px'], [null, '320px']], 3 / 2)));
const thumbImgs = await Promise.all(shots.map((t) => responsive(t.src, [[null, '56px']], 1)));
---

<NightSky title={`${item.name} · The Meridian`} description={item.shortDescription} image={item.primaryImage} jsonLd={objectData(item)} type="article" legible>
  <div class="ob" data-object>
    <SiteHeader current="collection" overlay z={20} />

    <main>
    <section class="ob-top">
      <div class="ob-axis"></div>
      <div class="ob-col">
        <div data-in="1" class="ob-crumbs">
          <a href="/collection">Collection</a><span>/</span><a href="/collection">{item.categoryName}</a><span>/</span><span style={island ? 'color:#F2CF85' : 'color:#F3ECDC'}>{item.thread}</span>
        </div>

        {/* Objects not yet photographed show no plate; their dimensions stay in the record. */}
        {item.primaryImage && (
          <>
            <div data-in="2" class="ob-plate" data-plate>
              <div class="ob-zoom" data-zoom>
                <img src={item.primaryImage} {...plateImg} alt={item.imageAltText || item.name} decoding="async" fetchpriority="high" />
              </div>
              <div class="ob-leave" data-leave hidden></div>
              <div class="ob-corner ob-tl"></div>
              <div class="ob-corner ob-br"></div>
              {hots.map((h, i) => (
                <button type="button" class="ob-ring" style={`left:${(h.x * 100).toFixed(3)}%;top:${(h.y * 100).toFixed(3)}%`} data-hot={i} aria-label={`Detail ${i + 1}: ${h.label}`}><span>{i + 1}</span></button>
              ))}
            </div>

            <div data-in="3" class="ob-cap">
              <span>{item.dimensions}</span>
              <button type="button" class="ob-inspect" data-inspect><span class="ob-insp">⊕ Inspect the details</span></button>
            </div>
          </>
        )}

        {gallery.length > 0 && (
          <div data-in="3" class="ob-details">
            {gallery.map((g, i) => (
              <figure class="ob-dfig">
                <div class="ob-detail" data-view={item.primaryImage ? i + 1 : i}><img src={g.src} {...detailImgs[i]} alt={g.alt} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" /></div>
                {g.caption && <figcaption class="ob-dcap">{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}

        <div data-in="4" class="ob-head">
          <div class="ob-eye">MERID-{item.itemId} · {item.era} · {item.originCountry}</div>
          <h1 class="ob-title">{item.name}</h1>
          <div class="ob-date">{item.dateDetail}</div>
          <div class="ob-maker">{item.maker}</div>
          <span class="ob-badge"><VerificationRing verified={verified} size={14} seal />{item.verification}</span>
          {item.story && <p class="ob-lede">{item.story}</p>}
        </div>
      </div>
    </section>

    <section class="ob-record">
      <aside class="ob-aside">
        <details class="ob-rec" open data-rec>
        <summary class="ob-sum"><span class="ob-sum-t"><span class="ob-sum-k">The record</span><span class="ob-sum-v">Maker, materials, origin, provenance</span></span><span class="ob-sum-plus" aria-hidden="true">+</span></summary>
        <div class="ob-rec-body">
        <div class="ob-rhead">The record</div>
        {item.dateDetail && <div class="ob-field"><span class="ob-k">Date</span><span class="ob-v">{item.dateDetail}</span></div>}
        {item.materials && <div class="ob-field"><span class="ob-k">Materials</span><span class="ob-v">{item.materials}</span></div>}
        {item.dimensions && <div class="ob-field"><span class="ob-k">Dimensions</span><span class="ob-v">{item.dimensions}</span></div>}
        <div class="ob-pair">
          <span class="ob-f"><span class="ob-k">Condition</span><span class="ob-v">{item.condition}</span></span>
          <span class="ob-f"><span class="ob-k">Origin</span><span class="ob-v">{item.originCountry}</span></span>
        </div>
        <div class="ob-prov">
          <span class="ob-k">Provenance</span>
          {item.provenance && <span class="ob-pv">{item.provenance}</span>}
          <span class="ob-status"><span class:list={['ob-dot', { 'ob-dot-open': !verified }]}></span>{item.verification}</span>
        </div>
        </div>
        </details>
        <script is:inline>matchMedia('(max-width: 767px)').matches && (document.currentScript.previousElementSibling.open = false)</script>
        <div class="ob-acts">
          <button type="button" class="ob-btn" data-cite={citation}>Copy citation</button>
          <a class="ob-btn" href={mail(`The Meridian: ${item.name}`)}>Write to the collector</a>
          <a class="ob-btn" href={mail(`Provenance tip: ${item.name}`)}>I know something about this</a>
        </div>
      </aside>

      <div class="ob-line" data-line>
        <div class="ob-fill" data-fill></div>
        <div class="ob-pstar" data-pstar></div>
      </div>

      <ObjectBody blocks={blocks} />
    </section>

    <section class="ob-sky">
      <div class="ob-sky-in">
        {cons.length > 0 && (
          <div data-reveal="1" class="ob-cons">
            <div class="ob-eye">In the sky</div>
            <h2 class="ob-cons-title">This star belongs to a constellation.</h2>
            {cons.map((c) => (
              <a href={`/narratives/${c.slug}`} class="ob-con">
                <span class="ob-glyph">
                  <svg viewBox="0 0 168 76" aria-hidden="true"><path d={c.d} /></svg>
                  {c.dots.map((p) => <span class="ob-gdot" style={`left:${p.left};top:${p.top};width:${p.size};height:${p.size};background:${p.color}`}></span>)}
                </span>
                <span class="ob-con-text">
                  <span class="ob-con-meta">{c.meta}</span>
                  <span class="ob-con-name">{c.name}</span>
                  <span class="ob-con-premise">{c.premise}</span>
                </span>
              </a>
            ))}
          </div>
        )}
        <div data-reveal="1" class:list={['ob-near', { 'ob-near-alone': !cons.length }]}>
          <div class="ob-eye ob-eye-dim">Neighbours in time</div>
          {earlier ? (
            <a href={`/collection/${earlier.slug}`} class="ob-nb"><span class="ob-dir">← Earlier</span><span class="ob-nbt"><span class="ob-nbn">{earlier.name}</span><span class="ob-nbd">{earlier.dateLabel}</span></span></a>
          ) : (
            <div class="ob-nb"><span class="ob-dir">← Earlier</span><span class="ob-nbt"><span class="ob-nbn">Nothing in the collection is older.</span><span class="ob-nbd">The first star in the sky</span></span></div>
          )}
          {later && (
            <a href={`/collection/${later.slug}`} class="ob-nb"><span class="ob-dir">Later →</span><span class="ob-nbt"><span class="ob-nbn">{later.name}</span><span class="ob-nbd">{later.dateLabel}</span></span></a>
          )}
          {alsoIsland.length > 0 && (
            <>
              <div class="ob-eye ob-eye-dim" style="margin-top:1.375rem">Also on the Island</div>
              {alsoIsland.map((it) => (
                <a href={`/collection/${it.slug}`} class="ob-isl"><span class="ob-isln">{it.name}</span><span class="ob-isld">{it.dateLabel}</span></a>
              ))}
            </>
          )}
          <div class="ob-citebox">
            <span class="ob-citek">Cite this object</span>
            <span class="ob-citev">{citation}</span>
          </div>
        </div>
      </div>
    </section>
    </main>

    <MottoFooter variant="object" />

    {shots.length > 0 && (
      <dialog class="vw" aria-label="Image viewer" data-viewer>
        <div class="vw-bar">
          <button type="button" class="vw-x" aria-label="Close" data-vw-close>×</button>
          <span class="vw-label" data-vw-label>Primary · 1×</span>
          <span></span>
        </div>
        <div class="vw-stage" data-vw-stage>
          <div class="vw-layer" data-vw-layer>
            <img src={shots[0].src} alt={shots[0].alt} loading="lazy" decoding="async" />
            {hots.map((h, i) => (
              <button type="button" class="vw-ring" style={`left:${(h.x * 100).toFixed(3)}%;top:${(h.y * 100).toFixed(3)}%`} data-vw-hot={i} aria-label={`Detail ${i + 1}: ${h.label}`}>{i + 1}</button>
            ))}
          </div>
        </div>
        <div class="vw-sheet" data-vw-sheet>
          <span class="vw-handle" aria-hidden="true"></span>
          <div class="vw-head" data-vw-head>
            <span class="vw-hl" data-vw-hl>Detail 1 of {hots.length}</span>
            <span class="vw-nav">
              <button type="button" aria-label="Previous detail" data-vw-prev>‹</button>
              <button type="button" aria-label="Next detail" data-vw-next>›</button>
            </span>
          </div>
          <span class="vw-dlabel" data-vw-dlabel hidden></span>
          <p class="vw-dtext" data-vw-dtext hidden></p>
          {shots.length > 1 && (
            <div class="vw-thumbs">
              {shots.map((t, i) => (
                <button type="button" class:list={['vw-thumb', { 'vw-on': i === 0 }]} aria-label={t.name} data-vw-thumb={i}><img src={t.src} {...thumbImgs[i]} alt="" loading="lazy" decoding="async" /></button>
              ))}
            </div>
          )}
        </div>
      </dialog>
    )}
  </div>
  <script type="application/json" id="ob-viewer" set:html={JSON.stringify({ shots, hots })} />
</NightSky>

<style>
  .ob{position:relative;background:transparent;color:#EEE7D7;overflow-x:clip}

  .ob-top{position:relative;padding:8rem var(--gut) 6rem;background:radial-gradient(ellipse 70% 60% at 50% 30%,rgba(40,55,110,.4) 0%,rgba(17,28,60,.4) 45%,rgba(7,10,20,0) 100%);overflow:hidden}
  .ob-axis{position:absolute;left:50%;top:0;bottom:0;width:1px;margin-left:-0.5px;background:linear-gradient(to bottom,rgba(211,179,112,0),rgba(211,179,112,.45) 12%,rgba(211,179,112,.2) 88%,rgba(211,179,112,0))}
  .ob-col{position:relative;max-width:73.75rem;margin:0 auto;display:flex;flex-direction:column;align-items:center}
  .ob-crumbs{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#8D897F;display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center;background:#0E1428;padding:.375rem .75rem}

  .ob-plate{position:relative;margin-top:2.25rem;width:min(61.25rem,100%);aspect-ratio:29.5/20.5;background:#0B1124;box-shadow:0 0 0 1px rgba(211,179,112,.28),0 40px 120px rgba(0,0,0,.6);overflow:hidden;color:#B8B2A5}
  .ob-zoom{position:absolute;inset:0;transition:transform .5s cubic-bezier(.16,1,.3,1);transform-origin:50% 50%}
  .ob-zoom img,.ob-detail img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ob-leave{position:absolute;inset:0;cursor:zoom-out;z-index:2}
  .ob-leave[hidden]{display:none}
  .ob-corner{position:absolute;width:22px;height:22px;pointer-events:none;z-index:3}
  .ob-tl{left:14px;top:14px;border-left:1px solid rgba(211,179,112,.6);border-top:1px solid rgba(211,179,112,.6)}
  .ob-br{right:14px;bottom:14px;border-right:1px solid rgba(211,179,112,.6);border-bottom:1px solid rgba(211,179,112,.6)}

  .ob-cap{width:min(61.25rem,100%);display:flex;justify-content:space-between;align-items:center;gap:1.25rem;margin-top:1rem;font:500 .625rem/1.4 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#8D897F}
  .ob-inspect{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border:1px solid rgba(211,179,112,.5);padding:.5625rem .875rem;background:#0B1124}
  @media (hover:hover) and (pointer:fine){.ob-inspect:hover{border-color:#D3B370}}
  .ob-details{width:min(61.25rem,100%);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.125rem}
  .ob-detail{position:relative;aspect-ratio:3/2;background:#0B1124;color:#8D897F;box-shadow:0 0 0 1px rgba(238,231,215,.1)}

  .ob-head{margin-top:4.5rem;max-width:56.25rem;display:flex;flex-direction:column;align-items:center;text-align:center;gap:1.125rem;background:radial-gradient(closest-side,#0C1226 70%,rgba(12,18,38,0));padding:.625rem 1.875rem}
  .ob-eye{font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
  .ob-title{margin:0;font:400 clamp(2.625rem,5.6vw,5rem)/1.02 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .ob-date{font:500 .6875rem/1.7 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .ob-maker{font:italic 400 1.125rem/1.45 'EB Garamond',Georgia,serif;color:#B8B2A5}
  .ob-badge{display:inline-flex;align-items:center;gap:.75rem;margin-top:.375rem;padding:.625rem 1rem;border:1px solid rgba(211,179,112,.45);font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#D3B370}
  .ob-lede{margin:1.125rem 0 0;max-width:46.25rem;font:italic 400 clamp(1.25rem,1.9vw,1.5625rem)/1.5 'EB Garamond',Georgia,serif;color:#E2DBCB;text-wrap:pretty}

  .ob-record{position:relative;max-width:77.5rem;margin:0 auto;padding:clamp(4.5rem,8vw,7.5rem) var(--gut);box-sizing:border-box;display:grid;grid-template-columns:minmax(15rem,19.375rem) 1px minmax(0,43.75rem);justify-content:center;column-gap:clamp(2rem,5vw,5rem)}
  .ob-aside{position:sticky;top:2rem;align-self:start;display:flex;flex-direction:column}
  .ob-rhead{font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370;padding-bottom:1rem}
  .ob-field{display:flex;flex-direction:column;gap:.3125rem;padding:.875rem 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-pair{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding:.875rem 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-f{display:flex;flex-direction:column;gap:.3125rem}
  .ob-k{font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#8D897F}
  .ob-v{font:400 1.03125rem/1.4 'EB Garamond',Georgia,serif;color:#E2DBCB}
  .ob-prov{display:flex;flex-direction:column;gap:.5rem;padding:.875rem 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-pv{font:400 1.03125rem/1.45 'EB Garamond',Georgia,serif;color:#E2DBCB}
  .ob-status{display:inline-flex;align-items:center;gap:.5rem;font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#D3B370}
  .ob-dot{width:7px;height:7px;border-radius:50%;background:#D3B370}
  .ob-dot-open{box-sizing:border-box;background:none;border:1px dashed #D3B370}
  .ob-acts{display:flex;flex-direction:column;gap:.625rem;padding:1.125rem 0 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-btn{text-align:left;font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border:1px solid rgba(211,179,112,.45);padding:.75rem .875rem}
  @media (hover:hover) and (pointer:fine){.ob-btn:hover{border-color:#D3B370;color:#F3ECDC}}

  .ob-line{position:relative;background:rgba(211,179,112,.16)}
  .ob-fill{position:absolute;left:0;top:0;width:1px;height:100%;background:#D3B370;transform-origin:0 0;transform:scaleY(0)}
  .ob-pstar{position:absolute;left:-4px;top:-4px;width:9px;height:9px;border-radius:50%;background:#FFF8E8;box-shadow:0 0 10px 3px rgba(255,248,232,.6),0 0 30px 8px rgba(211,179,112,.3)}

  .ob-sky{border-top:1px solid rgba(238,231,215,.1);background:radial-gradient(ellipse 60% 80% at 50% 0%,rgba(32,45,100,.4),rgba(7,10,20,0) 70%)}
  .ob-sky-in{max-width:77.5rem;margin:0 auto;box-sizing:border-box;padding:var(--sec) var(--gut);display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(2rem,5vw,5.5rem)}
  .ob-cons{display:flex;flex-direction:column;gap:1.125rem}
  .ob-cons-title{margin:0;font:400 clamp(2rem,3.6vw,3rem)/1.08 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .ob-con{display:grid;grid-template-columns:10.5rem minmax(0,1fr);gap:1.75rem;align-items:center;padding:1.625rem 0;border-top:1px solid rgba(238,231,215,.12);color:#EEE7D7}
  @media (hover:hover) and (pointer:fine){.ob-con:hover{border-top-color:rgba(211,179,112,.6);color:#EEE7D7}}
  .ob-glyph{position:relative;display:block;width:168px;height:76px}
  .ob-glyph svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .ob-glyph path{fill:none;stroke:rgba(211,179,112,.6);stroke-width:1}
  .ob-gdot{position:absolute;transform:translate(-50%,-50%);border-radius:50%;box-shadow:0 0 8px 2px rgba(255,240,205,.4)}
  .ob-con-text{display:flex;flex-direction:column;gap:.5rem}
  .ob-con-meta{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#8D897F}
  .ob-con-name{font:400 1.5rem/1.15 Gloock,Georgia,serif;color:#F3ECDC}
  .ob-con-premise{font:400 1.03125rem/1.5 'EB Garamond',Georgia,serif;color:#B8B2A5}

  .ob-near{display:flex;flex-direction:column;gap:.875rem}
  .ob-eye-dim{color:#8D897F}
  .ob-nb{display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:1.125rem;align-items:baseline;padding:1rem 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-dir{font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#D3B370}
  .ob-nbt{display:flex;flex-direction:column;gap:.3125rem}
  .ob-nbn{font:400 1.1875rem/1.2 Gloock,Georgia,serif;color:#F3ECDC}
  .ob-nbd,.ob-isld{font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .ob-isl{display:flex;justify-content:space-between;gap:1.125rem;align-items:baseline;padding:.875rem 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-isln{font:400 1.125rem/1.25 Gloock,Georgia,serif;color:#F2CF85}
  .ob-isld{flex:none}
  .ob-citebox{margin-top:1.625rem;padding:1.125rem 1.25rem;border:1px solid rgba(211,179,112,.3);display:flex;flex-direction:column;gap:.625rem}
