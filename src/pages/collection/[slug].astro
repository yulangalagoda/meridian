---
import NightSky from '../../layouts/NightSky.astro';
import { getSiteData } from '../../lib/notion';

export async function getStaticPaths() {
  const { items } = await getSiteData();
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<NightSky title={`${item.name} · The Meridian`} description={item.shortDescription} />
