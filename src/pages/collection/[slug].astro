---
// An object, from the Object - Taprobana reference (the template for every
// object page): the framed plate with "Inspect the details", the detail images,
// the title block, the sticky record beside the numbered story with its
// reading-progress star, then the object's constellations, its neighbours in
// time and its citation. Text is word for word from the item's Notion fields
// and page.
import NightSky from '../../layouts/NightSky.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MottoFooter from '../../components/MottoFooter.astro';
import VerificationRing from '../../components/VerificationRing.astro';
import ObjectBody from '../../components/object/ObjectBody.astro';
import { CONTACT_EMAIL } from '../../components/archive/types';
import { skyPositions, glyph } from '../../components/sky/geometry';
import { getSiteData, fetchPageBlocks } from '../../lib/notion';
import type { Item } from '../../lib/types';

export async function getStaticPaths() {
  const { items } = await getSiteData();
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const { items, narratives } = await getSiteData();
const blocks = await fetchPageBlocks(item.id);

const verified = item.verification === 'Verified';
const island = item.thread === 'The Island';
const bare = (id: string) => id.replace(/-/g, '');
const byId = new Map(items.map((it) => [bare(it.id), it]));

// Constellations this star belongs to.
const pos = skyPositions(items.map((it) => ({ slug: it.slug, year: it.year ?? 0 })));
const years = Object.fromEntries(items.map((it) => [it.slug, it.year ?? 0]));
const cons = narratives
  .filter((n) => n.itemIds.includes(bare(item.id)))
  .map((n) => {
    const its = n.itemIds.map((id) => byId.get(id)).filter(Boolean) as Item[];
    const ys = its.map((it) => it.year ?? 0);
    return { slug: n.slug, name: n.name, premise: n.premise, meta: n.itemIds.length + ' objects · ' + Math.min(...ys) + '–' + Math.max(...ys), ...glyph(pos, years, its.map((it) => it.slug), item.slug) };
  });

// Neighbours in time, and the rest of the Island thread.
const sorted = items.slice().sort((a, b) => (a.year ?? 0) - (b.year ?? 0) || a.displayOrder - b.displayOrder);
const at = sorted.indexOf(item);
const earlier = at > 0 ? sorted[at - 1] : null;
const later = at < sorted.length - 1 ? sorted[at + 1] : null;
const alsoIsland = island ? items.filter((it) => it.thread === 'The Island' && it.slug !== item.slug) : [];

const citation = `${item.name}, The Meridian, collection of Yulan Galagoda, meridian.yulan.me/collection/${item.slug}`;
const mail = (subject: string) => `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`;
const gallery = item.galleryImages.map((src, i) => ({ src, alt: item.galleryCaptions[i] ?? item.name }));
---

<NightSky title={`${item.name} · The Meridian`} description={item.shortDescription} legible>
  <div class="ob" data-object>
    <SiteHeader current="collection" overlay z={20} />

    <section class="ob-top">
      <div class="ob-axis"></div>
      <div class="ob-col">
        <div data-in="1" class="ob-crumbs">
          <a href="/collection">Collection</a><span>/</span><a href="/collection">{item.categoryName}</a><span>/</span><span style={island ? 'color:#F2CF85' : 'color:#F3ECDC'}>{item.thread}</span>
        </div>

        {/* Objects not yet photographed show no plate; their dimensions stay in the record. */}
        {item.primaryImage && (
          <>
            <div data-in="2" class="ob-plate" data-plate>
              <div class="ob-zoom" data-zoom>
                <img src={item.primaryImage} alt={item.imageAltText} decoding="async" />
              </div>
              <div class="ob-leave" data-leave hidden></div>
              <div class="ob-corner ob-tl"></div>
              <div class="ob-corner ob-br"></div>
            </div>

            <div data-in="3" class="ob-cap">
              <span>{item.dimensions}</span>
              <button type="button" class="ob-inspect" data-inspect>⊕ Inspect the details</button>
            </div>
          </>
        )}

        {gallery.length > 0 && (
          <div data-in="3" class="ob-details">
            {gallery.map((g) => <div class="ob-detail"><img src={g.src} alt={g.alt} loading="lazy" decoding="async" /></div>)}
          </div>
        )}

        <div data-in="4" class="ob-head">
          <div class="ob-eye">MERID-{item.itemId} · {item.era} · {item.originCountry}</div>
          <h1 class="ob-title">{item.name}</h1>
          <div class="ob-date">{item.dateDetail}</div>
          <div class="ob-maker">{item.maker}</div>
          <span class="ob-badge"><VerificationRing verified={verified} size={14} seal />{item.verification}</span>
          {item.story && <p class="ob-lede">{item.story}</p>}
        </div>
      </div>
    </section>

    <section class="ob-record">
      <aside class="ob-aside">
        <div class="ob-rhead">The record</div>
        {item.dateDetail && <div class="ob-field"><span class="ob-k">Date</span><span class="ob-v">{item.dateDetail}</span></div>}
        {item.materials && <div class="ob-field"><span class="ob-k">Materials</span><span class="ob-v">{item.materials}</span></div>}
        {item.dimensions && <div class="ob-field"><span class="ob-k">Dimensions</span><span class="ob-v">{item.dimensions}</span></div>}
        <div class="ob-pair">
          <span class="ob-f"><span class="ob-k">Condition</span><span class="ob-v">{item.condition}</span></span>
          <span class="ob-f"><span class="ob-k">Origin</span><span class="ob-v">{item.originCountry}</span></span>
        </div>
        <div class="ob-prov">
          <span class="ob-k">Provenance</span>
          {item.provenance && <span class="ob-pv">{item.provenance}</span>}
          <span class="ob-status"><span class:list={['ob-dot', { 'ob-dot-open': !verified }]}></span>{item.verification}</span>
        </div>
        <div class="ob-acts">
          <button type="button" class="ob-btn" data-cite={citation}>Copy citation</button>
          <a class="ob-btn" href={mail(`The Meridian: ${item.name}`)}>Write to the collector</a>
          <a class="ob-btn" href={mail(`Provenance tip: ${item.name}`)}>I know something about this</a>
        </div>
      </aside>

      <div class="ob-line" data-line>
        <div class="ob-fill" data-fill></div>
        <div class="ob-pstar" data-pstar></div>
      </div>

      <ObjectBody blocks={blocks} />
    </section>

    <section class="ob-sky">
      <div class="ob-sky-in">
        {cons.length > 0 && (
          <div data-reveal="1" class="ob-cons">
            <div class="ob-eye">In the sky</div>
            <h2 class="ob-cons-title">This star belongs to a constellation.</h2>
            {cons.map((c) => (
              <a href={`/narratives/${c.slug}`} class="ob-con">
                <span class="ob-glyph">
                  <svg viewBox="0 0 168 76" aria-hidden="true"><path d={c.d} /></svg>
                  {c.dots.map((p) => <span class="ob-gdot" style={`left:${p.left};top:${p.top};width:${p.size};height:${p.size};background:${p.color}`}></span>)}
                </span>
                <span class="ob-con-text">
                  <span class="ob-con-meta">{c.meta}</span>
                  <span class="ob-con-name">{c.name}</span>
                  <span class="ob-con-premise">{c.premise}</span>
                </span>
              </a>
            ))}
          </div>
        )}
        <div data-reveal="1" class="ob-near" style={cons.length ? undefined : 'grid-column:2'}>
          <div class="ob-eye ob-eye-dim">Neighbours in time</div>
          {earlier ? (
            <a href={`/collection/${earlier.slug}`} class="ob-nb"><span class="ob-dir">← Earlier</span><span class="ob-nbt"><span class="ob-nbn">{earlier.name}</span><span class="ob-nbd">{earlier.dateLabel}</span></span></a>
          ) : (
            <div class="ob-nb"><span class="ob-dir">← Earlier</span><span class="ob-nbt"><span class="ob-nbn">Nothing in the collection is older.</span><span class="ob-nbd">The first star in the sky</span></span></div>
          )}
          {later && (
            <a href={`/collection/${later.slug}`} class="ob-nb"><span class="ob-dir">Later →</span><span class="ob-nbt"><span class="ob-nbn">{later.name}</span><span class="ob-nbd">{later.dateLabel}</span></span></a>
          )}
          {alsoIsland.length > 0 && (
            <>
              <div class="ob-eye ob-eye-dim" style="margin-top:22px">Also on the Island</div>
              {alsoIsland.map((it) => (
                <a href={`/collection/${it.slug}`} class="ob-isl"><span class="ob-isln">{it.name}</span><span class="ob-isld">{it.dateLabel}</span></a>
              ))}
            </>
          )}
          <div class="ob-citebox">
            <span class="ob-citek">Cite this object</span>
            <span class="ob-citev">{citation}</span>
          </div>
        </div>
      </div>
    </section>

    <MottoFooter variant="object" />
  </div>
</NightSky>

<style>
  .ob{position:relative;background:#070A14;color:#EEE7D7;overflow-x:clip}

  .ob-top{position:relative;padding:128px clamp(20px,4.5vw,64px) 96px;background:radial-gradient(ellipse 70% 60% at 50% 30%,#141C38 0%,#0B1124 45%,#070A14 100%);overflow:hidden}
  .ob-axis{position:absolute;left:50%;top:0;bottom:0;width:1px;margin-left:-0.5px;background:linear-gradient(to bottom,rgba(211,179,112,0),rgba(211,179,112,.45) 12%,rgba(211,179,112,.2) 88%,rgba(211,179,112,0))}
  .ob-col{position:relative;max-width:1180px;margin:0 auto;display:flex;flex-direction:column;align-items:center}
  .ob-crumbs{font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.22em;text-transform:uppercase;color:#8D897F;display:flex;gap:12px;flex-wrap:wrap;justify-content:center;background:#0E1428;padding:6px 12px}

  .ob-plate{position:relative;margin-top:36px;width:min(980px,100%);aspect-ratio:29.5/20.5;background:#0B1124;box-shadow:0 0 0 1px rgba(211,179,112,.28),0 40px 120px rgba(0,0,0,.6);overflow:hidden;color:#B8B2A5}
  .ob-zoom{position:absolute;inset:0;transition:transform .5s cubic-bezier(.16,1,.3,1);transform-origin:50% 50%}
  .ob-zoom img,.ob-detail img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ob-leave{position:absolute;inset:0;cursor:zoom-out;z-index:2}
  .ob-leave[hidden]{display:none}
  .ob-corner{position:absolute;width:22px;height:22px;pointer-events:none;z-index:3}
  .ob-tl{left:14px;top:14px;border-left:1px solid rgba(211,179,112,.6);border-top:1px solid rgba(211,179,112,.6)}
  .ob-br{right:14px;bottom:14px;border-right:1px solid rgba(211,179,112,.6);border-bottom:1px solid rgba(211,179,112,.6)}

  .ob-cap{width:min(980px,100%);display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:16px;font:500 10px/1.4 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#8D897F}
  .ob-inspect{font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border:1px solid rgba(211,179,112,.5);padding:9px 14px;background:#0B1124}
  .ob-inspect:hover{border-color:#D3B370}
  .ob-details{width:min(980px,100%);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:18px}
  .ob-detail{position:relative;aspect-ratio:3/2;background:#0B1124;color:#8D897F;box-shadow:0 0 0 1px rgba(238,231,215,.1)}

  .ob-head{margin-top:72px;max-width:900px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;background:radial-gradient(closest-side,#0C1226 70%,rgba(12,18,38,0));padding:10px 30px}
  .ob-eye{font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
  .ob-title{margin:0;font:400 clamp(42px,5.6vw,80px)/1.02 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .ob-date{font:500 11px/1.7 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .ob-maker{font:italic 400 18px/1.45 'EB Garamond',Georgia,serif;color:#B8B2A5}
  .ob-badge{display:inline-flex;align-items:center;gap:12px;margin-top:6px;padding:10px 16px;border:1px solid rgba(211,179,112,.45);font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#D3B370}
  .ob-lede{margin:18px 0 0;max-width:740px;font:italic 400 clamp(20px,1.9vw,25px)/1.5 'EB Garamond',Georgia,serif;color:#E2DBCB;text-wrap:pretty}

  .ob-record{position:relative;max-width:1240px;margin:0 auto;padding:clamp(72px,8vw,120px) clamp(20px,4.5vw,64px);box-sizing:border-box;display:grid;grid-template-columns:minmax(240px,310px) 1px minmax(0,700px);justify-content:center;column-gap:clamp(32px,5vw,80px)}
  .ob-aside{position:sticky;top:32px;align-self:start;display:flex;flex-direction:column}
  .ob-rhead{font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370;padding-bottom:16px}
  .ob-field{display:flex;flex-direction:column;gap:5px;padding:14px 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-pair{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-f{display:flex;flex-direction:column;gap:5px}
  .ob-k{font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#8D897F}
  .ob-v{font:400 16.5px/1.4 'EB Garamond',Georgia,serif;color:#E2DBCB}
  .ob-prov{display:flex;flex-direction:column;gap:8px;padding:14px 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-pv{font:400 16.5px/1.45 'EB Garamond',Georgia,serif;color:#E2DBCB}
  .ob-status{display:inline-flex;align-items:center;gap:8px;font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#D3B370}
  .ob-dot{width:7px;height:7px;border-radius:50%;background:#D3B370}
  .ob-dot-open{box-sizing:border-box;background:none;border:1px dashed #D3B370}
  .ob-acts{display:flex;flex-direction:column;gap:10px;padding:18px 0 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-btn{text-align:left;font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border:1px solid rgba(211,179,112,.45);padding:12px 14px}
  .ob-btn:hover{border-color:#D3B370;color:#F3ECDC}

  .ob-line{position:relative;background:rgba(211,179,112,.16)}
  .ob-fill{position:absolute;left:0;top:0;width:1px;height:100%;background:#D3B370;transform-origin:0 0;transform:scaleY(0)}
  .ob-pstar{position:absolute;left:-4px;top:-4px;width:9px;height:9px;border-radius:50%;background:#FFF8E8;box-shadow:0 0 10px 3px rgba(255,248,232,.6),0 0 30px 8px rgba(211,179,112,.3)}

  .ob-sky{border-top:1px solid rgba(238,231,215,.1);background:radial-gradient(ellipse 60% 80% at 50% 0%,#111834,#070A14 70%)}
  .ob-sky-in{max-width:1240px;margin:0 auto;box-sizing:border-box;padding:clamp(80px,8vw,120px) clamp(20px,4.5vw,64px);display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(32px,5vw,88px)}
  .ob-cons{display:flex;flex-direction:column;gap:18px}
  .ob-cons-title{margin:0;font:400 clamp(32px,3.6vw,48px)/1.08 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .ob-con{display:grid;grid-template-columns:168px minmax(0,1fr);gap:28px;align-items:center;padding:26px 0;border-top:1px solid rgba(238,231,215,.12);color:#EEE7D7}
  .ob-con:hover{border-top-color:rgba(211,179,112,.6);color:#EEE7D7}
  .ob-glyph{position:relative;display:block;width:168px;height:76px}
  .ob-glyph svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .ob-glyph path{fill:none;stroke:rgba(211,179,112,.6);stroke-width:1}
  .ob-gdot{position:absolute;transform:translate(-50%,-50%);border-radius:50%;box-shadow:0 0 8px 2px rgba(255,240,205,.4)}
  .ob-con-text{display:flex;flex-direction:column;gap:8px}
  .ob-con-meta{font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#8D897F}
  .ob-con-name{font:400 24px/1.15 Gloock,Georgia,serif;color:#F3ECDC}
  .ob-con-premise{font:400 16.5px/1.5 'EB Garamond',Georgia,serif;color:#B8B2A5}

  .ob-near{display:flex;flex-direction:column;gap:14px}
  .ob-eye-dim{color:#8D897F}
  .ob-nb{display:grid;grid-template-columns:72px minmax(0,1fr);gap:18px;align-items:baseline;padding:16px 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-dir{font:500 9.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#D3B370}
  .ob-nbt{display:flex;flex-direction:column;gap:5px}
  .ob-nbn{font:400 19px/1.2 Gloock,Georgia,serif;color:#F3ECDC}
  .ob-nbd,.ob-isld{font:500 9.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .ob-isl{display:flex;justify-content:space-between;gap:18px;align-items:baseline;padding:14px 0;border-top:1px solid rgba(238,231,215,.1)}
  .ob-isln{font:400 18px/1.25 Gloock,Georgia,serif;color:#F2CF85}
  .ob-isld{flex:none}
  .ob-citebox{margin-top:26px;padding:18px 20px;border:1px solid rgba(211,179,112,.3);display:flex;flex-direction:column;gap:10px}
  .ob-citek{font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}
  .ob-citev{font:400 13px/1.6 'IBM Plex Mono',monospace;color:#E2DBCB;word-break:break-word}

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-in]{opacity:0}
  }
</style>

<script>
  // Port of the Object reference's componentDidMount / toggle / progress /
  // renderVals: entrance, scroll reveals, the reading-progress star, the
  // inspection zoom (2.6×, following the pointer, Esc to leave) and Copy citation.
  const root = document.querySelector<HTMLElement>('[data-object]');
  if (root) {
    const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = 'cubic-bezier(.16,1,.3,1)';
    if (!reduced) {
      root.querySelectorAll<HTMLElement>('[data-in]').forEach((el) => {
        const i = +(el.dataset.in ?? 0);
        el.animate([{ opacity: 0, transform: 'translateY(26px)', filter: 'blur(6px)' }, { opacity: 1, transform: 'none', filter: 'blur(0px)' }], { duration: 1400, delay: 150 + i * 220, easing: ease, fill: 'both' });
      });
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        (e.target as HTMLElement).animate([{ opacity: 0, transform: 'translateY(26px)' }, { opacity: 1, transform: 'none' }], { duration: 1200, easing: ease, fill: 'both' });
      }), { threshold: 0.12 });
      root.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        if (el.getBoundingClientRect().top > innerHeight) { el.style.opacity = '0'; io.observe(el); }
      });
    }
    document.documentElement.classList.remove('js');

    // Reading progress: the star rides the line as the story passes 45% of the viewport.
    const line = root.querySelector<HTMLElement>('[data-line]');
    const fill = root.querySelector<HTMLElement>('[data-fill]');
    const star = root.querySelector<HTMLElement>('[data-pstar]');
    let rq = 0;
    const progress = () => {
      if (!line) return;
      const r = line.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, (innerHeight * 0.45 - r.top) / r.height));
      if (fill) fill.style.transform = 'scaleY(' + p.toFixed(4) + ')';
      if (star) star.style.transform = 'translateY(' + (p * r.height).toFixed(1) + 'px)';
    };
    const onScroll = () => { if (!rq) rq = requestAnimationFrame(() => { rq = 0; progress(); }); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    progress();

    // Inspection.
    const plate = root.querySelector<HTMLElement>('[data-plate]');
    const zoom = root.querySelector<HTMLElement>('[data-zoom]');
    const leave = root.querySelector<HTMLElement>('[data-leave]');
    const button = root.querySelector<HTMLButtonElement>('[data-inspect]');
    let inspecting = false;
    const toggle = () => {
      inspecting = !inspecting;
      if (zoom) { zoom.style.transform = inspecting ? 'scale(2.6)' : ''; if (!inspecting) zoom.style.transformOrigin = '50% 50%'; }
      if (leave) leave.hidden = !inspecting;
      if (button) button.textContent = inspecting ? 'Leave inspection ✕' : '⊕ Inspect the details';
    };
    button?.addEventListener('click', toggle);
    leave?.addEventListener('click', toggle);
    plate?.addEventListener('pointermove', (e) => {
      if (!inspecting || !zoom) return;
      const r = plate.getBoundingClientRect();
      zoom.style.transformOrigin = (((e.clientX - r.left) / r.width) * 100).toFixed(2) + '% ' + (((e.clientY - r.top) / r.height) * 100).toFixed(2) + '%';
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && inspecting) toggle(); });

    // Copy citation.
    const cite = root.querySelector<HTMLButtonElement>('[data-cite]');
    let copyT = 0;
    cite?.addEventListener('click', () => {
      try { navigator.clipboard && navigator.clipboard.writeText(cite.dataset.cite ?? ''); } catch (err) {}
      cite.textContent = 'Citation copied ✓';
      clearTimeout(copyT);
      copyT = window.setTimeout(() => { cite.textContent = 'Copy citation'; }, 2200);
    });
  }
</script>
