  .vw-dtext{margin:0;font:400 1.0625rem/1.45 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}
  .vw-thumbs{display:flex;gap:8px;padding-top:12px;border-top:1px solid rgba(238,231,215,.1);overflow-x:auto;scrollbar-width:none}
  .vw-thumb{flex:none;width:56px;height:56px;padding:0;background:#0B1124;box-shadow:0 0 0 1px rgba(238,231,215,.12)}
  .vw-thumb img{display:block;width:100%;height:100%;object-fit:cover}
  .vw-thumb.vw-on{box-shadow:0 0 0 1px #D3B370}
