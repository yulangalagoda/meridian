    .ob-ring span{width:28px;height:28px;box-sizing:border-box;display:grid;place-items:center;border-radius:50%;border:1px solid #F2D493;background:rgba(7,10,20,.5);font:500 .625rem/1 'IBM Plex Mono',monospace;color:#F2D493}
    .ob-cap{margin-top:.375rem;gap:.75rem;font-size:var(--mono-min);letter-spacing:.14em}
    .ob-insp{padding:.5625rem .75rem}
    .ob-details{display:flex;gap:.75rem;width:calc(100% + 2 * var(--gut));margin-top:.625rem;padding:0 var(--gut);box-sizing:border-box;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding:0 var(--gut);scrollbar-width:none}
    .ob-details::-webkit-scrollbar{display:none}
    .ob-dfig{flex:none;width:220px;display:flex;flex-direction:column;gap:.5rem;scroll-snap-align:start}
    .ob-dcap{display:block;font:500 var(--mono-min)/1.3 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
    .ob-head{margin-top:3rem;padding:0;gap:.875rem;background:none}
    .ob-eye{font-size:.625rem}
    .ob-title{font-size:clamp(2.125rem,10vw,2.75rem)}
    .ob-date{font-size:.65625rem}
    .ob-maker{font-size:1.0625rem}
    .ob-badge{min-height:44px;box-sizing:border-box;margin-top:0;padding:0 1rem;font-size:.625rem}
    .ob-lede{margin-top:.625rem;font-size:1.25rem}
    .ob-record{padding-top:2.75rem}
    .ob-sum{display:flex;align-items:center;justify-content:space-between;gap:1rem;height:60px;border-top:1px solid rgba(238,231,215,.12);border-bottom:1px solid rgba(238,231,215,.12);list-style:none;cursor:pointer}
    .ob-sum::-webkit-details-marker{display:none}
    .ob-sum-t{display:flex;flex-direction:column;gap:6px}
    .ob-sum-k{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
    .ob-sum-v{font:italic 400 .9375rem/1 'EB Garamond',Georgia,serif;color:#8D897F}
    .ob-sum-plus{font:400 1.5rem/1 Gloock,Georgia,serif;color:#D3B370;transition:transform .3s ease}
    .ob-rec[open] .ob-sum-plus{transform:rotate(45deg)}
    .ob-rhead{display:none}
    .ob-rec-body{padding-top:.25rem}
    .ob-cons-title{font-size:1.875rem}
    .ob-con{grid-template-columns:minmax(0,1fr);gap:.75rem;padding:1.375rem 0}
    .ob-con-name{order:-1;font-size:1.3125rem}
  }
  @media (prefers-reduced-motion:reduce){ .ob-line,.ob-sum-plus{transition:none} }

  /* The touch viewer (board 5b). */
  .vw{position:fixed;inset:0;box-sizing:border-box;width:100%;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;overflow:hidden;background:#05070F;color:#EEE7D7}
  .vw[open]{display:flex;flex-direction:column;animation:vw-in .3s ease}
  .vw::backdrop{background:#05070F}
  @keyframes vw-in{from{opacity:0}}
  @media (prefers-reduced-motion:reduce){ .vw[open]{animation:none} }
  .vw-bar{flex:none;height:calc(56px + env(safe-area-inset-top));box-sizing:border-box;padding:env(safe-area-inset-top) max(8px,env(safe-area-inset-right)) 0 max(8px,env(safe-area-inset-left));display:grid;grid-template-columns:44px minmax(0,1fr) 44px;align-items:center}
  .vw-x{width:44px;height:44px;display:grid;place-items:center;font:400 1.875rem/1 'EB Garamond',Georgia,serif;color:#EEE7D7}
  .vw-label{justify-self:center;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}
  .vw-stage{position:relative;flex:1;min-height:0;overflow:hidden;touch-action:none}
  .vw-layer{position:absolute;left:0;top:0;transform-origin:0 0}
  .vw-layer img{display:block;width:100%;height:100%;object-fit:contain;user-select:none;-webkit-user-drag:none;pointer-events:none}
  .vw-ring{position:absolute;width:44px;height:44px;display:grid;place-items:center;font:500 .625rem/1 'IBM Plex Mono',monospace;color:#F2D493;transform:translate(-50%,-50%)}
  .vw-ring::before{content:'';position:absolute;left:8px;top:8px;width:28px;height:28px;box-sizing:border-box;border-radius:50%;border:1px solid rgba(242,212,147,.7)}
  .vw-ring.vw-on{font-size:.6875rem}
  .vw-ring.vw-on::before{left:5px;top:5px;width:34px;height:34px;border-color:#F2D493;background:rgba(242,212,147,.18);box-shadow:0 0 24px 6px rgba(211,179,112,.35)}
  .vw-ring[hidden]{display:none}
  .vw-sheet{flex:none;box-sizing:border-box;max-height:45dvh;overflow-y:auto;display:flex;flex-direction:column;gap:12px;padding:10px max(20px,env(safe-area-inset-right)) calc(26px + env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left));background:rgba(11,17,36,.98);border-top:1px solid rgba(211,179,112,.45)}
  .vw-sheet[hidden],.vw-head[hidden],.vw-dlabel[hidden],.vw-dtext[hidden]{display:none}
  .vw-handle{align-self:center;width:36px;height:4px;border-radius:2px;background:rgba(238,231,215,.25)}
  .vw-head{display:flex;justify-content:space-between;align-items:center}
  .vw-hl{font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#D3B370}
  .vw-nav{display:flex;gap:4px}
  .vw-nav button{width:44px;height:44px;display:grid;place-items:center;font:400 1.25rem/1 'EB Garamond',Georgia,serif;color:#B8B2A5}
