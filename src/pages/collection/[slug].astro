    .ob-plate{margin-top:1.5rem;width:calc(100% + 2 * var(--gut));max-width:none;box-shadow:0 0 0 1px rgba(211,179,112,.28),0 30px 80px rgba(0,0,0,.6)}
    .ob-corner{width:18px;height:18px}
