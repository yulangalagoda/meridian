---
import NightSky from '../../layouts/NightSky.astro';
import { getSiteData } from '../../lib/notion';

export async function getStaticPaths() {
  const { narratives } = await getSiteData();
  return narratives.map((narrative) => ({ params: { slug: narrative.slug }, props: { narrative } }));
}

const { narrative } = Astro.props;
---

<NightSky title={`${narrative.name} · The Meridian`} description={narrative.premise} />
