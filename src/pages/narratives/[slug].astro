---
// A narrative, from the "Narrative - The Year 1927" reference (the template for
// every narrative). The constellation is pinned on the left; the story scrolls
// on the right. The story is the narrative's Notion page: the opening, one
// section per H3 (a section can name several objects, e.g. England South / West
// / East), then the close after the divider. Each section is a station: as it
// reaches the middle of the screen its star opens into a circular image and the
// line to it draws in (the reference's IntersectionObserver and renderVals,
// ported in the script below).
//
// Where the template is specific to 1927 it is generalised from the data: the
// counts come from the sections and objects; the faint year behind the sky and
// the dashed "Waiting · the next object from …" star belong to narratives named
// for a year; "More constellations" lists up to three narratives that share an
// object with this one, nearest in Display Order first.
import NightSky from '../../layouts/NightSky.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { storyPoints } from '../../components/sky/geometry';
import { inWords, roman } from '../../components/words';
import { fetchNarrativeContent, getSiteData } from '../../lib/notion';
import type { Item, Narrative } from '../../lib/types';

export async function getStaticPaths() {
  const { narratives } = await getSiteData();
  return narratives.map((narrative) => ({ params: { slug: narrative.slug }, props: { narrative } }));
}

interface Props { narrative: Narrative }
const { narrative } = Astro.props;
const { items, narratives } = await getSiteData();
const content = await fetchNarrativeContent(narrative.id);

const bare = (id: string) => id.replace(/-/g, '');
const yearOf = (it: Item) => it.year ?? 0;
const mine = narrative.itemIds.map((id) => items.find((it) => bare(it.id) === id)).filter(Boolean) as Item[];
const byName = (name: string) => mine.find((it) => it.name === name) ?? items.find((it) => it.name === name);

// Sections → stations; each named object is a star, in story order.
const sections = content.sections.map((s, k) => ({
  num: roman(k + 1),
  place: s.placeHtml,
  html: s.html,
  items: s.names.map(byName).filter(Boolean) as Item[],
}));
const stars = sections.flatMap((s, k) => s.items.map((it, j) => ({ it, sec: k, first: j === 0, num: s.num })));
const missing = mine.filter((it) => !stars.some((s) => s.it === it));
if (missing.length) console.warn(`[narratives] ${narrative.slug}: no H3 for ${missing.map((it) => it.name).join(', ')}`);

const S = sections.length, F = S + 1;
const raw = storyPoints(items.map((it) => ({ slug: it.slug, year: yearOf(it) })), stars.map((s) => s.it.slug));
const xs = raw.map((p) => p[0]), ys = raw.map((p) => p[1]);
const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
const frac = raw.map((p) => [0.2 + 0.6 * (x1 > x0 ? (p[0] - x0) / (x1 - x0) : 0.5), 0.2 + 0.5 * (y1 > y0 ? (p[1] - y0) / (y1 - y0) : 0.5)]);

// Narratives named for a year keep the template's year treatments.
const year = /\b(1[5-9]\d\d)\b/.exec(narrative.name)?.[1] ?? null;

// The story's HTML, split into its top-level blocks.
const chunks = (html: string) => html.match(/<(p|h2|h3|blockquote|figure|pre|ul|ol)\b[^>]*>[\s\S]*?<\/\1>|<hr>/g) ?? [];
const isQuote = (c: string) => c.startsWith('<blockquote>');
const pull = (c: string) => (isQuote(c) ? '<p class="nr-pull">' + c.slice(12, -13) + '</p>' : c);

// The opening: its first paragraph starts on a gold drop cap.
const opening = chunks(content.openingHtml);
const firstP = opening.findIndex((c) => c.startsWith('<p>'));
let drop = '', dropRest = '';
if (firstP >= 0) {
  const inner = opening[firstP].slice(3, -4);
  let i = 0;
  while (inner[i] === '<') i = inner.indexOf('>', i) + 1;
  const len = inner[i] === '&' ? inner.indexOf(';', i) + 1 - i : String.fromCodePoint(inner.codePointAt(i) ?? 32).length;
  drop = inner.slice(i, i + len);
  dropRest = inner.slice(0, i) + inner.slice(i + len);
}

// The close: [blocks before the pull quote] · the pull quote · [the rest] · the last block.
const close = chunks(content.closeHtml);
const qi = close.findIndex(isQuote);
const lead = qi > 0 ? close.slice(0, qi) : [];
const quote = qi >= 0 ? close[qi] : null;
const rest = qi >= 0 ? close.slice(qi + 1) : close;
const middle = rest.slice(0, -1);
const last = rest.length ? rest[rest.length - 1] : null;
const closeStations = [
  ...(lead.length ? [{ kind: 'mid', html: lead.map(pull).join('') }] : []),
  ...(quote ? [{ kind: 'quote', html: pull(quote) }] : []),
  ...(middle.length ? [{ kind: 'mid', html: middle.map(pull).join('') }] : []),
];
const finalStation = F + closeStations.length;

// More constellations: narratives sharing an object, nearest in Display Order first.
const ids = new Set(narrative.itemIds);
const others = narratives.filter((n) => n.slug !== narrative.slug);
const near = (a: Narrative, b: Narrative) => Math.abs(a.displayOrder - narrative.displayOrder) - Math.abs(b.displayOrder - narrative.displayOrder) || a.displayOrder - b.displayOrder;
const sharing = others.filter((n) => n.itemIds.some((id) => ids.has(id))).sort(near);
const more = [...sharing, ...others.filter((n) => !sharing.includes(n)).sort(near)].slice(0, 3);

// The reference renders at 700×800 until it measures the stage.
const W0 = 700, H0 = 800;
const seg = (a: number[], b: number[]) => {
  const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy) || 1, o = L * 0.12;
  const cx = (a[0] + b[0]) / 2 - (dy / L) * o, cy = (a[1] + b[1]) / 2 + (dx / L) * o;
  return { d: 'M' + a[0].toFixed(1) + ' ' + a[1].toFixed(1) + ' Q' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ' ' + b[0].toFixed(1) + ' ' + b[1].toFixed(1), len: Math.ceil(L * 1.06) };
};
const P0 = frac.map((f) => [f[0] * W0, f[1] * H0]);
const segs0 = stars.slice(1).map((_, j) => seg(P0[j], P0[j + 1]));

const data = { raw, stars: stars.map((s) => ({ sec: s.sec, first: s.first })), S, F, final: finalStation, wait: Boolean(year) };
---

<NightSky title={`${narrative.name} · The Meridian`} description={narrative.premise} legible>
  <div class="nr" data-narrative>
    <SiteHeader current="narratives" overlay z={20} passThrough />

    <section class="nr-grid">
      <div class="nr-left">
        <div class="nr-stage" data-stage>
          <canvas class="nr-canvas" data-canvas></canvas>
          {year && <div class="nr-ghost" aria-hidden="true">{year}</div>}
          <svg viewBox={`0 0 ${W0} ${H0}`} class="nr-svg" data-svg aria-hidden="true">
            {segs0.map((s) => <path class="nr-seg" data-seg d={s.d} style={`stroke-dasharray:${s.len};stroke-dashoffset:${s.len}`} />)}
            {year && <path class="nr-seg3" data-seg3 d="" style="opacity:0" />}
          </svg>
          {stars.map((s, i) => (
            <button type="button" class="nr-star" data-star={i} style={`left:${(frac[i][0] * 100).toFixed(3)}%;top:${(frac[i][1] * 100).toFixed(3)}%;z-index:2`}>
              <span class="nr-ap" data-ap style="width:0px;height:0px;opacity:0;box-shadow:0 0 0 1px rgba(211,179,112,0),0 30px 80px rgba(0,0,0,.55)">
                {s.it.primaryImage && <img src={s.it.primaryImage} alt={s.it.imageAltText || s.it.name} loading="lazy" decoding="async" />}
              </span>
              <span class="nr-dot" data-dot style="width:6px;height:6px;box-shadow:0 0 8px 2px rgba(255,240,205,.35);opacity:.55"></span>
              <span class="nr-lab" data-lab style={`left:${frac[i][0] > 0.58 ? -16 : 16}px;top:0px;transform:${frac[i][0] > 0.58 ? 'translate(-100%,-50%)' : 'translate(0,-50%)'};text-align:${frac[i][0] > 0.58 ? 'right' : 'left'};opacity:0`}>
                <span class="nr-lab-num">{s.num} · {s.it.dateLabel}</span>
                <span class="nr-lab-name">{s.it.name}</span>
              </span>
            </button>
          ))}
          {year && (
            <div class="nr-wait" data-wait hidden>
              <span class="nr-wait-ring"></span>
              <span class="nr-wait-text">Waiting · the next object from {year}</span>
            </div>
          )}
          <div class="nr-progress">
            <span data-station-label>Prologue</span>
            <span class="nr-bar"><span data-bar style="width:0%"></span></span>
          </div>
          <div class="nr-hint">Click a star to visit it</div>
        </div>
      </div>

      <div class="nr-story">
        <div data-station="0" class="nr-st0">
          <div class="nr-eyebrow">Narrative · a constellation of {inWords(stars.length)}</div>
          <h1 class="nr-h1" data-h1>{narrative.name}</h1>
          <p class="nr-premise">{narrative.premise}</p>
          <div class="nr-open">
            {opening.map((c, i) => i === firstP
              ? <p><span class="nr-drop" set:html={drop} /><Fragment set:html={dropRest} /></p>
              : <Fragment set:html={pull(c)} />)}
          </div>
        </div>

        {sections.map((s, k) => (
          <div data-station={k + 1} class="nr-sec">
            <div class="nr-eyebrow">{s.num} · <Fragment set:html={s.place} /></div>
            <div class="nr-body" set:html={chunks(s.html).map(pull).join('')} />
            {s.items.map((it) => (
              <a href={`/collection/${it.slug}`} class="nr-row">
                <span class="nr-row-text">
                  <span class="nr-row-name">{it.name}</span>
                  <span class="nr-row-meta">{it.dateLabel} · {it.verification}</span>
                </span>
                <span class="nr-row-open">Open →</span>
              </a>
            ))}
          </div>
        ))}

        {closeStations.map((c, k) => (
          <div data-station={F + k} class:list={[c.kind === 'quote' ? 'nr-st-quote' : 'nr-st-mid']}>
            <div class="nr-close" set:html={c.html} />
          </div>
        ))}

        <div data-station={finalStation} class="nr-st-final">
          {last && <div class="nr-close" set:html={pull(last)} />}
          <div class="nr-more">
            <span class="nr-more-label">More constellations</span>
            {more.map((n) => <a href={`/narratives/${n.slug}`} class="nr-more-link">{n.name} →</a>)}
            <a href="/" class="nr-back">← Back to the whole sky</a>
          </div>
        </div>
      </div>
    </section>
  </div>
  <script type="application/json" id="nr-data" set:html={JSON.stringify(data)} />
</NightSky>

<style>
  .nr{position:relative;background:#070A14;color:#EEE7D7}
  .nr-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}
  .nr-left{position:relative}
  .nr-stage{position:sticky;top:0;height:100vh;min-height:640px;overflow:hidden;background:radial-gradient(ellipse 80% 70% at 50% 45%,#151D3A 0%,#0B1124 50%,#070A14 100%)}
  .nr-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .nr-ghost{position:absolute;left:0;right:0;bottom:6%;text-align:center;font:400 clamp(160px,19vw,300px)/1 Gloock,Georgia,serif;color:rgba(211,179,112,.06);letter-spacing:-.02em;pointer-events:none}
  .nr-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
  .nr-seg{fill:none;stroke:rgba(232,206,150,.8);stroke-width:1.3;stroke-linecap:round;transition:stroke-dashoffset 1.6s cubic-bezier(.6,0,.2,1)}
  .nr-seg3{fill:none;stroke:rgba(232,206,150,.45);stroke-width:1;stroke-linecap:round;stroke-dasharray:4 7;transition:opacity 1.6s ease}

  .nr-star{position:absolute;width:0;height:0}
  .nr-ap{position:absolute;left:0;top:0;transform:translate(-50%,-50%);border-radius:50%;overflow:hidden;color:#B8B2A5;background:#0B1124;transition:width 1.1s cubic-bezier(.16,1,.3,1),height 1.1s cubic-bezier(.16,1,.3,1),opacity .8s}
  .nr-ap img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .nr-dot{position:absolute;left:0;top:0;transform:translate(-50%,-50%);border-radius:50%;background:#FFF6E2;transition:all .8s cubic-bezier(.16,1,.3,1)}
  .nr-lab{position:absolute;width:max-content;max-width:220px;display:flex;flex-direction:column;gap:4px;transition:all .8s cubic-bezier(.16,1,.3,1)}
  .nr-lab-num{font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#D3B370}
  .nr-lab-name{font:400 17px/1.15 Gloock,Georgia,serif;color:#F3ECDC}

  .nr-wait{position:absolute;width:0;height:0}
  .nr-wait[hidden]{display:none}
  .nr-wait-ring{position:absolute;left:-14px;top:-14px;width:28px;height:28px;box-sizing:border-box;border-radius:50%;border:1px dashed rgba(211,179,112,.7)}
  .nr-wait-text{position:absolute;left:24px;top:-8px;width:max-content;font:italic 400 16px/1.3 'EB Garamond',Georgia,serif;color:#D3B370}

  .nr-progress{position:absolute;left:clamp(20px,3vw,40px);bottom:28px;display:flex;align-items:center;gap:14px;font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}
  .nr-bar{position:relative;width:120px;height:1px;background:rgba(238,231,215,.15)}
  .nr-bar span{position:absolute;left:0;top:0;bottom:0;background:#D3B370;transition:width 1s cubic-bezier(.16,1,.3,1)}
  .nr-hint{position:absolute;right:clamp(20px,3vw,40px);bottom:28px;font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}

  .nr-story{padding:168px clamp(28px,5vw,88px) 28vh clamp(28px,4vw,72px);box-sizing:border-box;max-width:700px;font:400 20.5px/1.72 'EB Garamond',Georgia,serif;color:#D9D2C3;text-wrap:pretty}
  .nr-st0{min-height:70vh}
  .nr-sec{min-height:62vh;padding-top:12vh}
  .nr-st-quote{min-height:56vh;padding-top:14vh}
  .nr-st-mid{padding-top:12vh}
  .nr-st-final{padding-top:4vh}

  .nr-eyebrow{font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
  .nr-h1{margin:18px 0 22px;font:400 clamp(60px,7vw,104px)/.98 Gloock,Georgia,serif;color:#F3ECDC}
  .nr-premise{margin:0 0 40px;font:italic 400 23px/1.5 'EB Garamond',Georgia,serif;color:#E2DBCB}
  .nr-open > :global(*){margin:0}
  .nr-open > :global(* + *){margin-top:1.1em}
  .nr-open > :global(figure){margin:40px 0}
  .nr-drop{float:left;font:400 86px/.8 Gloock,Georgia,serif;color:#D3B370;margin:10px 14px 0 0}

  .nr-body :global(p){margin:0 0 1.1em}
  .nr-body > :global(:first-child){margin-top:18px}
  .nr-body > :global(:last-child){margin-bottom:26px}
  .nr-story :global(a:not([class])){color:#F2D493;border-bottom:1px solid rgba(211,179,112,.4)}

  .nr-row{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:16px 0;border-top:1px solid rgba(238,231,215,.12);border-bottom:1px solid rgba(238,231,215,.12)}
  .nr-row + .nr-row{margin-top:-1px}
  .nr-row-text{display:flex;flex-direction:column;gap:5px}
  .nr-row-name{font:400 19px/1.2 Gloock,Georgia,serif;color:#F3ECDC}
  .nr-row-meta{font:500 9.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .nr-row-open{font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#D3B370}

  .nr-close :global(p){margin:0 0 1.1em}
  .nr-story :global(.nr-pull){margin:0;padding:30px 0;border-top:1px solid rgba(211,179,112,.4);border-bottom:1px solid rgba(211,179,112,.4);font:400 clamp(30px,3vw,42px)/1.22 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .nr-st-mid :global(.nr-pull),.nr-body :global(.nr-pull){margin:0 0 1.1em}

  .nr-story :global(figure){margin:40px 0}
  .nr-story :global(figure img){display:block;width:100%;height:auto;border:1px solid rgba(238,231,215,.12)}
  .nr-story :global(figcaption){margin-top:12px;font:italic 400 15px/1.5 'EB Garamond',Georgia,serif;color:#8D897F}

  .nr-more{margin-top:72px;padding-top:28px;border-top:1px solid rgba(238,231,215,.12);display:flex;flex-direction:column;gap:14px}
  .nr-more-label{font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#8D897F}
  .nr-more-link{font:400 22px/1.3 Gloock,Georgia,serif;color:#F3ECDC}
  .nr-back{margin-top:14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#D3B370}
</style>

<script>
  // Port of the reference's componentDidMount, startSky, points, seg and
  // renderVals. Stations are the story's blocks; the one crossing the middle of
  // the screen (rootMargin -42% / -52%) is current.
  const root = document.querySelector<HTMLElement>('[data-narrative]');
  const json = document.getElementById('nr-data');
  if (root && json) {
    const D: { raw: [number, number][]; stars: { sec: number; first: boolean }[]; S: number; F: number; final: number; wait: boolean } = JSON.parse(json.textContent ?? '{}');
    const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const segEls = [...root.querySelectorAll<SVGPathElement>('[data-seg]')];
    const seg3 = root.querySelector<SVGPathElement>('[data-seg3]');
    const wait = root.querySelector<HTMLElement>('[data-wait]');
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-star]')];
    const label = root.querySelector<HTMLElement>('[data-station-label]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const R = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV', 'XVI', 'XVII', 'XVIII', 'XIX', 'XX'];
    let station = 0, W = 700, H = 800, first = true;

    const points = () => {
      const xs = D.raw.map((p) => p[0]), ys = D.raw.map((p) => p[1]);
      const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
      return D.raw.map((p) => [W * (0.2 + 0.6 * (x1 > x0 ? (p[0] - x0) / (x1 - x0) : 0.5)), H * (0.2 + 0.5 * (y1 > y0 ? (p[1] - y0) / (y1 - y0) : 0.5))]);
    };
    const seg = (a: number[], b: number[]) => {
      const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy) || 1, o = L * 0.12;
      const cx = (a[0] + b[0]) / 2 - (dy / L) * o, cy = (a[1] + b[1]) / 2 + (dx / L) * o;
      return { d: 'M' + a[0].toFixed(1) + ' ' + a[1].toFixed(1) + ' Q' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ' ' + b[0].toFixed(1) + ' ' + b[1].toFixed(1), len: Math.ceil(L * 1.06) };
    };

    const render = () => {
      const st = station, P = points(), AP = Math.min(220, W * 0.3);
      label.textContent = st === 0 ? 'Prologue' : st <= D.S ? 'Star ' + R[st - 1] + ' of ' + R[D.S - 1] : 'The constellation, complete';
      bar.style.width = ((Math.min(st, D.F) / D.F) * 100).toFixed(0) + '%';
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      D.stars.forEach((s, i) => {
        const p = P[i], active = st === s.sec + 1, open = active && s.first, seen = st > s.sec + 1 || st >= D.F || (active && !s.first);
        const left = p[0] > W * 0.58, off = open ? AP / 2 + 20 : 16;
        const b = btns[i], ap = b.children[0] as HTMLElement, dot = b.children[1] as HTMLElement, lab = b.children[2] as HTMLElement;
        b.style.left = p[0].toFixed(1) + 'px'; b.style.top = p[1].toFixed(1) + 'px'; b.style.zIndex = open ? '3' : '2';
        ap.style.width = ap.style.height = open ? AP + 'px' : '0px';
        ap.style.opacity = open ? '1' : '0';
        ap.style.boxShadow = '0 0 0 1px rgba(211,179,112,' + (open ? '.55' : '0') + '),0 30px 80px rgba(0,0,0,.55)';
        dot.style.width = dot.style.height = seen ? '9px' : '6px';
        dot.style.opacity = open ? '0' : seen ? '1' : '0.55';
        dot.style.boxShadow = seen ? '0 0 14px 5px rgba(255,240,205,.7),0 0 36px 12px rgba(211,179,112,.3)' : '0 0 8px 2px rgba(255,240,205,.35)';
        lab.style.left = (left ? -off : off) + 'px'; lab.style.top = '0px';
        lab.style.transform = left ? 'translate(-100%,-50%)' : 'translate(0,-50%)';
        lab.style.textAlign = left ? 'right' : 'left';
        lab.style.opacity = open || seen ? '1' : '0';
      });
      segEls.forEach((el, j) => {
        const s = seg(P[j], P[j + 1]);
        el.setAttribute('d', s.d);
        el.style.strokeDasharray = String(s.len);
        el.style.strokeDashoffset = String(st >= D.stars[j + 1].sec + 1 ? 0 : s.len);
      });
      if (seg3 && wait) {
        const C = [[0.84, 0.24], [0.84, 0.76], [0.16, 0.76], [0.16, 0.24]].map((c) => [c[0] * W, c[1] * H]);
        const wpt = C.map((c) => ({ c, d: Math.min(...P.map((p) => Math.hypot(p[0] - c[0], p[1] - c[1]))) })).sort((a, b) => b.d - a.d)[0].c;
        seg3.setAttribute('d', seg(P[P.length - 1], wpt).d);
        seg3.style.opacity = st >= D.final ? '1' : '0';
        wait.hidden = st < D.final;
        wait.style.left = wpt[0].toFixed(1) + 'px'; wait.style.top = wpt[1].toFixed(1) + 'px';
      }
    };

    // The first render after measuring the stage happens without transitions, so
    // lines laid out for 700×800 don't animate to the real size.
    const paint = () => {
      if (!first) { render(); return; }
      first = false;
      const els = [...segEls, ...btns.flatMap((b) => [...b.children] as HTMLElement[])] as (HTMLElement | SVGElement)[];
      els.forEach((e) => (e.style.transition = 'none'));
      render();
      void stage.offsetWidth;
      els.forEach((e) => (e.style.transition = ''));
    };
    const measure = () => { W = Math.round(stage.clientWidth); H = Math.round(stage.clientHeight); paint(); };
    measure();
    new ResizeObserver(measure).observe(stage);

    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { station = +(e.target.getAttribute('data-station') ?? 0); paint(); }
    }), { rootMargin: '-42% 0px -52% 0px' });
    root.querySelectorAll('[data-station]').forEach((el) => io.observe(el));

    btns.forEach((b, i) => b.addEventListener('click', () => {
      const el = root.querySelector('[data-station="' + (D.stars[i].sec + 1) + '"]');
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - innerHeight * 0.3, behavior: reduced ? 'auto' : 'smooth' });
    }));

    const h1 = root.querySelector('[data-h1]');
    if (h1 && !reduced) h1.animate([{ opacity: 0, transform: 'translateY(24px)', filter: 'blur(8px)' }, { opacity: 1, transform: 'none', filter: 'blur(0px)' }], { duration: 1600, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' });

    // The twinkling field behind the constellation.
    const cv = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = cv.getContext('2d')!, dpr = Math.min(2, window.devicePixelRatio || 1);
    const field = Array.from({ length: 260 }, () => ({ x: Math.random(), y: Math.random(), r: Math.random() * Math.random() * 1.3 + 0.25, a: Math.random() * 0.6 + 0.2, s: Math.random() * 1.8 + 0.4, p: Math.random() * 6.28 }));
    const draw = (t: number) => {
      if (!reduced) requestAnimationFrame(draw);
      const w = cv.clientWidth, h = cv.clientHeight;
      if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);
      for (const s of field) { ctx.globalAlpha = s.a * (0.55 + 0.45 * Math.sin((t / 1000) * s.s + s.p)); ctx.fillStyle = s.r > 1 ? '#FFF4DC' : '#D9E1F4'; ctx.beginPath(); ctx.arc(s.x * w, s.y * h, s.r, 0, 6.283); ctx.fill(); }
    };
    if (!reduced) requestAnimationFrame(draw); else draw(0);
  }
</script>
