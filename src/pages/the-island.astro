---
// The Island thread, from The Island reference. The hero text is the thread's
// description on the Collecting Policy page; the objects are those whose Thread
// is "The Island", in year order, with dashed links scaled to the years between;
// "Still below the horizon" lists the Seeking wants whose bold title is coloured
// yellow in Notion (the colour of The Island option; the site ignores colour).
import NightSky from '../layouts/NightSky.astro';
import SkyPage from '../components/SkyPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MottoFooter from '../components/MottoFooter.astro';
import Star from '../components/Star.astro';
import VerificationRing from '../components/VerificationRing.astro';
import { getSiteData, fetchPageBlocks, POLICY_PAGES } from '../lib/notion';
import { blockSpans, splitBoldLead } from '../lib/richtext';
import { responsive } from '../lib/images';
import { breadcrumbs, listPage } from '../components/seo';

const { items } = await getSiteData();
const [policy, seeking] = await Promise.all([
  fetchPageBlocks(POLICY_PAGES['collecting-policy'].id),
  fetchPageBlocks(POLICY_PAGES['seeking'].id),
]);

const thread = policy.map((b) => splitBoldLead(blockSpans(b))).find((l) => l?.lead.startsWith('The Island'));
const wants = seeking
  .map((b) => blockSpans(b))
  .filter((spans) => spans[0]?.annotations?.bold && spans[0].annotations.color === 'yellow')
  .map((spans) => splitBoldLead(spans)!.lead);

const its = items.filter((it) => it.thread === 'The Island').sort((a, b) => (a.year ?? 0) - (b.year ?? 0) || a.displayOrder - b.displayOrder);
// Images (4:3): nearly full width on phones, about 380px beside the text above that.
const imgs = await Promise.all(its.map((it) => responsive(it.primaryImage, [['(max-width: 767px)', '92vw'], [null, '380px']], 4 / 3)));
const entries = its.map((it, i) => {
  const g = i ? (it.year ?? 0) - (its[i - 1].year ?? 0) : 0;
  return {
    it,
    img: imgs[i],
    gap: i ? (g ? g + ' years later' : 'The same decade') : '',
    gapH: Math.round(28 + Math.min(g, 300) * 0.4) + 'px',
  };
});
const span = its.length ? its[0].year + '–' + its[its.length - 1].year : '';
const description = `The Island thread: ${its.length} objects from Sri Lanka and Ceylon across every century (maps, photographs, documents and books) in the order they were made, and what the thread is still seeking.`;
const jsonLd = [
  listPage('The Island — The Meridian', '/the-island/', description, its.map((it) => ({ name: it.name, path: `/collection/${it.slug}/` }))),
  breadcrumbs([['The Meridian', '/'], ['The Island', '/the-island/']]),
];
---

<NightSky title="The Island · The Meridian" description={description} jsonLd={jsonLd}>
  <SkyPage glow="#1A1C2E">
    <SiteHeader current="island" />

    <main>
    <section class="is-hero">
      <Star kind="island" />
      <div class="is-eye">Thread one · {its.length} objects · {span}</div>
      <h1 class="is-title">The Island</h1>
      {thread && <p class="is-intro" set:html={thread.restHtml} />}
    </section>

    <section class="is-line">
      {entries.map(({ it, img, gap, gapH }) => (
        <div class="is-entry">
          {gap && (
            <div class="is-gap" style={`--gh:${gapH}`}>
              <span class="is-dash"></span>
              <span class="is-gaptext">{gap}</span>
            </div>
          )}
          <article class="is-row">
            <div class="is-when">
              <span class="is-year">{it.year}</span>
              <span class="is-era">{it.era}</span>
            </div>
            <div class="is-body">
              <div class="is-image">{it.primaryImage && <img src={it.primaryImage} {...img} alt={it.imageAltText || it.name} loading="lazy" decoding="async" />}</div>
              <div class="is-text">
                <span class="is-meta">{it.dateLabel} · {it.originCountry}</span>
                <h2 class="is-name">{it.name}</h2>
                <p class="is-short">{it.shortDescription}</p>
                <div class="is-foot">
                  <span class="is-ver"><VerificationRing verified={it.verification === 'Verified'} size={9} />{it.verification}</span>
                  <a href={`/collection/${it.slug}`} class="is-read">Read the object →</a>
                </div>
              </div>
            </div>
          </article>
        </div>
      ))}
    </section>

    <section class="is-below">
      <div class="is-below-in">
        <div class="is-ask">
          <div class="is-eye">Still below the horizon</div>
          <h2 class="is-asktitle">What the island thread is seeking.</h2>
          <a href="/seeking" class="is-all">The full want list →</a>
        </div>
        <div class="is-wants">
          {wants.map((w) => (
            <div class="is-want"><VerificationRing verified={false} size={11} noShrink /><span class="is-wanttitle">{w}</span></div>
          ))}
        </div>
      </div>
    </section>
    </main>

    <MottoFooter variant="island" />
  </SkyPage>
</NightSky>

<style>
  .is-hero{max-width:61.25rem;margin:0 auto;box-sizing:border-box;padding:clamp(4.5rem,9vw,8.75rem) var(--gut) clamp(3.5rem,6vw,5.5rem);text-align:center;display:flex;flex-direction:column;align-items:center;gap:1.375rem}
  .is-eye{font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.24em;text-transform:uppercase;color:#D3B370}
  .is-title{margin:0;font:400 clamp(4rem,9vw,8rem)/.95 Gloock,Georgia,serif;color:#F2CF85;letter-spacing:-.01em}
  .is-intro{margin:.5rem 0 0;max-width:40rem;font:400 clamp(1.25rem,1.9vw,1.5rem)/1.55 'EB Garamond',Georgia,serif;color:#D9D2C3;text-wrap:pretty}

  .is-line{max-width:67.5rem;margin:0 auto;box-sizing:border-box;padding:0 var(--gut) var(--sec)}
  .is-entry{display:flex;flex-direction:column}
  .is-gap{display:flex;align-items:center;gap:1.125rem;padding:0 0 0 calc(clamp(6rem,14vw,10.625rem) - 1px)}
  .is-dash{width:1px;height:var(--gh);background:repeating-linear-gradient(to bottom,rgba(211,179,112,.6) 0 3px,rgba(211,179,112,0) 3px 9px)}
  .is-gaptext{font:italic 400 1rem/1 'EB Garamond',Georgia,serif;color:#8D897F}
  .is-row{display:grid;grid-template-columns:clamp(6rem,14vw,10.625rem) minmax(0,1fr);gap:0 clamp(1.5rem,4vw,3.5rem);padding:1.75rem 0;border-top:1px solid rgba(238,231,215,.1)}
  .is-when{display:flex;flex-direction:column;align-items:flex-end;gap:.625rem;padding-right:clamp(1rem,2vw,1.75rem);border-right:1px solid rgba(211,179,112,.5)}
  .is-year{font:400 clamp(1.875rem,3.6vw,3rem)/1 Gloock,Georgia,serif;color:#F2D493;font-variant-numeric:tabular-nums}
  .is-era{font:italic 400 .9375rem/1.2 'EB Garamond',Georgia,serif;color:#8D897F;text-align:right}
  .is-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16.25rem),1fr));gap:1.5rem clamp(1.5rem,3vw,2.75rem);align-items:start}
  .is-image{position:relative;aspect-ratio:4/3;background:#0B1124;color:#8D897F;box-shadow:0 0 0 1px rgba(238,231,215,.12),0 30px 60px -24px #000}
  .is-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .is-text{display:flex;flex-direction:column;gap:.75rem}
  .is-meta{font:500 var(--mono-min)/1.4 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#8D897F}
  .is-name{margin:0;font:400 clamp(1.5rem,2.4vw,1.875rem)/1.15 Gloock,Georgia,serif;color:#F3ECDC;text-wrap:balance}
  .is-short{margin:0;font:400 1.125rem/1.55 'EB Garamond',Georgia,serif;color:#B8B2A5;text-wrap:pretty}
  .is-foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.75rem;margin-top:.375rem}
  .is-ver{display:inline-flex;align-items:center;gap:.5rem;font:500 var(--mono-min)/1 'IBM Plex Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#B8B2A5}
  .is-read{font:500 .625rem/1 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#F3ECDC;border-bottom:1px solid rgba(211,179,112,.6);padding-bottom:.3125rem}

  .is-below{border-top:1px solid rgba(238,231,215,.1);background:radial-gradient(ellipse 50% 80% at 50% 100%,rgba(32,45,100,.4),rgba(7,10,20,0) 75%)}
  .is-below-in{max-width:67.5rem;margin:0 auto;box-sizing:border-box;padding:clamp(4.5rem,8vw,7.5rem) var(--gut);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:2.5rem clamp(2.5rem,6vw,6rem)}
  .is-ask{display:flex;flex-direction:column;gap:1.125rem}
  .is-asktitle{margin:0;font:400 clamp(2rem,3.6vw,3rem)/1.05 Gloock,Georgia,serif;color:#F3ECDC}
  .is-all{align-self:flex-start;margin-top:.5rem;font:500 .65625rem/1 'IBM Plex Mono',monospace;letter-spacing:.18em;text-transform:uppercase;color:#F3ECDC;border-bottom:1px solid rgba(211,179,112,.6);padding-bottom:.4375rem}
  .is-wants{display:flex;flex-direction:column}
  .is-want{display:flex;align-items:baseline;gap:1rem;padding:1.125rem 0;border-top:1px solid rgba(238,231,215,.12)}
  .is-want:last-child{border-bottom:1px solid rgba(238,231,215,.12)}
  .is-wanttitle{font:400 1.3125rem/1.3 Gloock,Georgia,serif;color:#F3ECDC}

  @media (max-width:1023px){
    .is-read,.is-all{display:inline-flex;align-items:flex-end;min-height:44px;box-sizing:border-box}
  }
  /* Phones (board 6c): H1 clamp(56px, 17vw, 80px); each row stacks — year
     clamp(52px, 16vw, 72px) over its gold rule, image 4:3, meta, name,
     description, ring and link; the dashed gap runs down the left edge, its
     height still scaled to the years, clamped to 48–200px. */
  @media (max-width:767px){
    .is-hero{padding-top:2.75rem;gap:1rem}
    .is-eye{font-size:.625rem;line-height:1.5}
    .is-title{font-size:clamp(3.5rem,17vw,5rem)}
    .is-intro{margin-top:.25rem;font-size:1.1875rem}
    .is-gap{position:relative;height:clamp(48px,var(--gh),200px);margin:1rem 0;padding:0}
    .is-dash{position:absolute;left:0;top:0;bottom:0;height:auto;width:0;background:none;border-left:1px dashed rgba(211,179,112,.5)}
    .is-gaptext{margin-left:1.125rem;font-size:1.0625rem;color:#D3B370}
    .is-row{display:flex;flex-direction:column;gap:0;padding:0;border-top:0}
    .is-when{flex-direction:row;align-items:baseline;gap:.75rem;padding:0 0 .75rem;border-right:0;background:linear-gradient(90deg,#D3B370,rgba(211,179,112,.1)) left bottom / 100% 1px no-repeat}
    .is-year{font-size:clamp(3.25rem,16vw,4.5rem);color:#F2CF85}
    .is-body{display:flex;flex-direction:column;align-items:stretch;gap:.75rem;margin-top:1.375rem}
    .is-text{gap:.75rem}
    .is-meta{margin-top:.375rem}
    .is-name{font-size:1.5rem;color:#F2CF85}
    .is-short{font-size:1.0625rem}
    .is-foot{margin-top:0}
    .is-read{align-items:center;height:44px;padding-bottom:0;border-bottom:0}
  }
</style>
